#define p_two ((dfloat)2)

// hex @kernel for screened coulomb potential mat-vec
#define squareThreads					   \
  for(int j=0; j<p_Nq; ++j; @inner(1))			   \
    for(int i=0; i<p_Nq; ++i; @inner(0))



// square thread version
@kernel void stressPartialAxQuad2D(const dlong Nelements,
                                   @restrict const  dlong   *  elementList,
                                   @restrict const  dlong   *  GlobalToLocal,
                                   @restrict const  dfloat *  nut,
                                   @restrict const  dfloat *  wJ,
                                   @restrict const  dfloat *  vgeo,
                                   @restrict const  dfloat *  DT,
                                   @restrict const  dfloat *  S,
                                   @restrict const  dfloat *  MM,
                                   const dfloat   lambda,
                                   @restrict const  dfloat *  q,
                                   @restrict dfloat *  Aq){

  for(dlong e=0;e<Nelements;++e;@outer(0)){

    @shared dfloat s_q[p_Nfields][p_Nq][p_Nq];
    @shared dfloat s_DT[p_Nq][p_Nq];

    // oh dear
    @shared dfloat s_rx_qx[p_Nfields][p_Nq][p_Nq];
    @shared dfloat s_sx_qx[p_Nfields][p_Nq][p_Nq];
    @shared dfloat s_ry_qx[p_Nfields][p_Nq][p_Nq];
    @shared dfloat s_sy_qx[p_Nfields][p_Nq][p_Nq];
    @shared dfloat s_rx_qy[p_Nfields][p_Nq][p_Nq];
    @shared dfloat s_sx_qy[p_Nfields][p_Nq][p_Nq];
    @shared dfloat s_ry_qy[p_Nfields][p_Nq][p_Nq];
    @shared dfloat s_sy_qy[p_Nfields][p_Nq][p_Nq];
    
    @exclusive dlong element;
    @exclusive dfloat r_qr[p_Nfields], r_qs[p_Nfields], r_Aq[p_Nfields];

    @exclusive dfloat r_rx, r_ry, r_sx, r_sy, r_wJ, r_nut;

    // prefetch q(:,:,:,e) to @shared
    squareThreads{
      element = elementList[e];
      const dlong base = i + j*p_Nq + element*p_Np;
      const dlong id = GlobalToLocal[base];
      for(int fld=0;fld<p_Nfields;++fld)
	s_q[fld][j][i] = (id!=-1) ? q[id*p_Nfields+fld] : 0.0;

      // fetch DT to @shared
      s_DT[j][i] = DT[j*p_Nq+i];
    }

    @barrier();

    squareThreads{

      // assumes w*J built into G entries
      const dlong id = element*p_Np + j*p_Nq + i;
      r_nut = nut[id];
      
      const dlong base = element*p_Nvgeo*p_Np + j*p_Nq + i;
      r_rx = vgeo[base+p_RXID*p_Np];
      r_ry = vgeo[base+p_RYID*p_Np];
      r_sx = vgeo[base+p_SXID*p_Np];
      r_sy = vgeo[base+p_SYID*p_Np];
      r_wJ = vgeo[base+p_JWID*p_Np];
      
      for(int fld=0;fld<p_Nfields;++fld){
	r_qr[fld] = 0;
	r_qs[fld] = 0;
      }

#pragma unroll p_Nq
      for(int n=0; n<p_Nq; ++n){
	dfloat Din = s_DT[i][n];
	
#pragma unroll p_Nfields
	for(int fld=0;fld<p_Nfields;++fld)
	  r_qr[fld] += Din*s_q[fld][j][n];
	
	dfloat Djn = s_DT[j][n];

#pragma unroll p_Nfields
	for(int fld=0;fld<p_Nfields;++fld)
	  r_qs[fld] += Djn*s_q[fld][n][i];
      }
      
      for(int fld=0;fld<p_Nfields;++fld){
	r_Aq[fld] = r_wJ*lambda*s_q[fld][j][i];
      }

      r_wJ *= r_nut;
    }

    @barrier();
    
    squareThreads{
      for(int fld=0;fld<p_Nfields;++fld){
	dfloat qx = r_rx*r_qr[fld] + r_sx*r_qs[fld];
	dfloat qy = r_ry*r_qr[fld] + r_sy*r_qs[fld];
	// Dr'*(rx*wJ*rx)*Dr + Ds'*(sx*wJ*sx)*Ds
	s_rx_qx[fld][j][i] = r_rx*r_wJ*qx;
	s_sx_qx[fld][j][i] = r_sx*r_wJ*qx;
	s_ry_qx[fld][j][i] = r_ry*r_wJ*qx;
	s_sy_qx[fld][j][i] = r_sy*r_wJ*qx;

	s_rx_qy[fld][j][i] = r_rx*r_wJ*qy;
	s_sx_qy[fld][j][i] = r_sx*r_wJ*qy;
	s_ry_qy[fld][j][i] = r_ry*r_wJ*qy;
	s_sy_qy[fld][j][i] = r_sy*r_wJ*qy;
      }
    }

    @barrier();
    
    squareThreads{
      dfloat qxx[p_Nfields] = {0.f};
      dfloat qxy[p_Nfields] = {0.f};
      dfloat qyx[p_Nfields] = {0.f};
      dfloat qyy[p_Nfields] = {0.f};

#pragma unroll p_Nq
      for(int n=0;n<p_Nq;++n) {

	dfloat Dni = s_DT[n][i];
#pragma unroll p_Nfields
	for(int fld=0;fld<p_Nfields;++fld){
	  qxx[fld] += Dni*s_rx_qx[fld][j][n];
	  qyx[fld] += Dni*s_ry_qx[fld][j][n];
	  qxy[fld] += Dni*s_rx_qy[fld][j][n];
	  qyy[fld] += Dni*s_ry_qy[fld][j][n];
	}

	dfloat Dnj = s_DT[n][j];
#pragma unroll p_Nfields
	for(int fld=0;fld<p_Nfields;++fld){
	  qxx[fld] += Dnj*s_sx_qx[fld][n][i];
	  qyx[fld] += Dnj*s_sy_qx[fld][n][i];
	  qxy[fld] += Dnj*s_sx_qy[fld][n][i];
	  qyy[fld] += Dnj*s_sy_qy[fld][n][i];
	}
      }

      /*
	\sum_j d_j ( nu (d_j u_i + d_i u_j ))
	=> -\sum_j (d_j phi, nu (d_j u_i + d_i u_j ))
	
	Dx'*nu*Dx*u + Dy'*nu*Dy*u + Dx'*nu*Dx*u + Dy'*nu*Dx*v
	Dx'*nu*Dx*v + Dy'*nu*Dy*v + Dx'*nu*Dy*u + Dy'*nu*Dy*v
	
      */

      dfloat fac = p_two;
#if 1
      r_Aq[0] += fac*qxx[0] + qyy[0] +  qyx[1];
      r_Aq[1] += fac*qyy[1] + qxx[1] +  qxy[0];
#else
      r_Aq[0] += qxx[0] + qyy[0];
      r_Aq[1] += qyy[1] + qxx[1];
#endif
      const dlong base = p_Nfields*(element*p_Np + j*p_Nq + i);
      for(int fld=0;fld<p_Nfields;++fld){
	Aq[base+fld] = r_Aq[fld];
      }
    }
  }
}

