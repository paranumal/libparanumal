// square thread version
@kernel void massFilterTri2D(const dlong   Nelements,
			     @restrict const  dfloat *  FILT,
			     @restrict const  dfloat *  q,
			     @restrict dfloat *  Aq){
  
  for(dlong e=0;e<Nelements;++e;@outer(0)){
    
    @shared dfloat s_q[p_Nfields][p_Np];

    for(int n=0;n<p_Np;++n;@inner(0)){
      const dlong base =n + e*p_Np*p_Nfields;
      for(int fld=0;fld<p_Nfields;++fld){
	s_q[fld][n] = q[base+fld*p_Np];
      }
    }
    
    // prefetch q(:,:,:,e) to @shared
    for(int n=0;n<p_Np;++n;@inner(0)){
      // assumes w*J built into G entries
      dfloat r_Aq[p_Nfields] = {0.};

      for(int i=0;i<p_Np;++i){
	dfloat FILTni = FILT[n+i*p_Np];
	for(int fld=0;fld<p_Nfields;++fld){
	  r_Aq[fld] += FILTni*s_q[fld][i];
	}
      }

      const dlong base = e*p_Np*p_Nfields + n;
      
      for(int fld=0;fld<p_Nfields;++fld){
	Aq[base+fld*p_Np] = r_Aq[fld];
      }
    }
  }
}




// square thread version
@kernel void massAxTri2D(const dlong   Nelements,
			 @restrict const  dfloat *  wJ,
			  @restrict const  dfloat *  MM,
			 @restrict const  dfloat *  q,
			 @restrict dfloat *  Aq){
  
  for(dlong e=0;e<Nelements;++e;@outer(0)){
    
    @shared dfloat s_q[p_Nfields][p_Np];

    for(int n=0;n<p_Np;++n;@inner(0)){
      const dlong base =n + e*p_Np*p_Nfields;
      for(int fld=0;fld<p_Nfields;++fld){
	s_q[fld][n] = q[base+fld*p_Np];
      }
    }
    
    // prefetch q(:,:,:,e) to @shared
    for(int n=0;n<p_Np;++n;@inner(0)){
      // assumes w*J built into G entries
      dfloat J = wJ[e];
      dfloat r_Aq[p_Nfields] = {0.};

      for(int i=0;i<p_Np;++i){
	dfloat MMni = MM[n+i*p_Np];
	for(int fld=0;fld<p_Nfields;++fld){
	  r_Aq[fld] += MMni*s_q[fld][i];
	}
      }

      const dlong base = p_Nfields*(n + e*p_Np);
      
      for(int fld=0;fld<p_Nfields;++fld){
	Aq[base+fld] = J*r_Aq[fld];
      }
    }
  }
}

// square thread version
@kernel void massPartialAxTri2D(const dlong Nelements,
				@restrict const  dlong   *  elementList,
				@restrict const  dlong   *  GlobalToLocal,
				@restrict const  dfloat *  wJ,
				@restrict const  dfloat *  MM,
				@restrict const  dfloat *  q,
				@restrict dfloat *  Aq){
  
  for(dlong e=0;e<Nelements;++e;@outer(0)){
    
    @exclusive dlong element;
    @shared dfloat s_q[p_Nfields][p_Np];

    for(int n=0;n<p_Np;++n;@inner(0)){

      element = elementList[e];
      
      const dlong base = n + element*p_Np;
      const dlong id = p_Nfields*GlobalToLocal[base];
      for(int fld=0;fld<p_Nfields;++fld){
	s_q[fld][n] = q[id+fld];
      }
    }
    
    // prefetch q(:,:,:,e) to @shared
    for(int n=0;n<p_Np;++n;@inner(0)){

      dfloat J = wJ[element];
      dfloat r_Aq[p_Nfields] = {0.};

#pragma unroll p_Np
      for(int i=0;i<p_Np;++i){
	dfloat MMni = MM[n+i*p_Np];

#pragma unroll p_Nfields
	for(int fld=0;fld<p_Nfields;++fld){
	  r_Aq[fld] += MMni*s_q[fld][i];
	}
      }
      
      const dlong base = p_Nfields*(n + element*p_Np);

      for(int fld=0;fld<p_Nfields;++fld){
	Aq[base+fld] = J*r_Aq[fld];
      }
    }
  }
}

@kernel void massBuildOperatorDiagonalTri2D(const dlong Nelements,
					     @restrict const  dfloat *  wJ,
					     @restrict const  dfloat *  MM,
					     @restrict dfloat * A){


#define p_two ((dfloat)2)
  
  for(dlong e=0;e<Nelements;++e;@outer(0)){

    for (int n=0;n<p_Np;++n;@inner(0)) {

      dfloat Au[p_Nfields] = {0.};
      dfloat JW = wJ[e];

#if 1
      dfloat MMnn = MM[n*p_Np+n];
      for(int fld=0;fld<p_Nfields;++fld){
	Au[fld] += JW*MMnn;
      }
#else
      dfloat MMn = 0;
      for(int i=0;i<p_Np;++i){
      	MMn += fabs(MM[n*p_Np+i]);
      }
      for(int fld=0;fld<p_Nfields;++fld){
      	Au[fld] += JW*MMn;
      }
#endif
      const dlong base = p_Nfields*(e*p_Np +n);
      for(int fld=0;fld<p_Nfields;++fld){
	A[base+fld] = Au[fld];
      }
    }
  }
}


@kernel void massReciprocal(const dlong N,
			      @restrict const  dfloat *q,
			      @restrict pfloat *invq){

  for(dlong n=0;n<N;++n;@tile(256,@outer,@inner)){
    invq[n] = ((dfloat)1.)/q[n];
  }
}


// square thread version
@kernel void massRhsTri2D(const dlong   Nelements,
			  @restrict const  dfloat *  wJ,
			  @restrict const  dfloat *  MM,
			  @restrict const  dfloat *  U,
			  @restrict dfloat *  Urhs,
			  @restrict dfloat *  Vrhs){

  for(dlong e=0;e<Nelements;++e;@outer(0)){

    @shared dfloat s_U[p_Nfields][p_Np];

    for(int n=0;n<p_Np;++n;@inner(0)){
      const dlong base = n + e*p_Np*p_Nfields;
      for(int fld=0;fld<p_Nfields;++fld){
	s_U[fld][n] = U[base+fld*p_Np];
      }
    }
    
    // prefetch q(:,:,:,e) to @shared
    for(int n=0;n<p_Np;++n;@inner(0)){
      const dlong base = n + e*p_Np;
      
      // assumes w*J built into G entries
      dfloat J = wJ[e];
      dfloat r_Urhs[p_Nfields] = {0.};

      for(int i=0;i<p_Np;++i){
	dfloat Mni = MM[n+i*p_Np];
	for(int fld=0;fld<p_Nfields;++fld){
	  r_Urhs[fld] += Mni*s_U[fld][i];
	}
      }

      {
	const dlong base = p_Nfields*(n + e*p_Np);
	for(int fld=0;fld<p_Nfields;++fld){
	  Urhs[base+fld] = J*r_Urhs[fld];
	}
      }
    }
  }
}

  
@kernel void massScatterTri2D(const dlong   Nelements,
			      @restrict const  dlong   *  GlobalToLocal,
			      @restrict dfloat *  UG,
			      @restrict dfloat *  UL){
  

  for(dlong e=0;e<Nelements;++e;@outer(0)){
    for(int n=0;n<p_Np;++n;@inner(0)){
      const dlong base = n + e*p_Np;
      const dlong id = p_Nfields*GlobalToLocal[base];
      const dlong idL = e*p_Np*p_Nfields+n;
      for(int fld=0;fld<p_Nfields;++fld){
	UL[idL+fld*p_Np] = UG[id+fld];
      }
    }
  }
}


@kernel void massWeightTri2D(const dlong   Ngather,
			     @restrict pfloat *wG,
			     @restrict pfloat *UG){
  

  for(int n=0;n<Ngather;++n;@tile(256,@outer(0),@inner(0))){
    dlong id = n*p_Nfields;
    dfloat wn = wG[n];
    for(int fld=0;fld<p_Nfields;++fld){
      UG[id+fld] *= wn;
    }
  }
}
