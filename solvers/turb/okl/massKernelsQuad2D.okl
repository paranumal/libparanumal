// hex @kernel for screened coulomb potential mat-vec
#define squareThreads                           \
    for(int j=0; j<p_Nq; ++j; @inner(1))           \
      for(int i=0; i<p_Nq; ++i; @inner(0))


// square thread version used to build rhs
@kernel void massAxQuad2D(const dlong   Nelements,
			  @restrict const  dfloat *  wJ,
			  @restrict const  dfloat *  MM,
			  @restrict const  dfloat *  q,
			  @restrict dfloat *  Aq){

  for(dlong e=0;e<Nelements;++e;@outer(0)){

    // prefetch q(:,:,:,e) to @shared
    squareThreads{
      const dlong base = i + j*p_Nq + e*p_Np;

      // assumes w*J built into G entries
      dfloat r_GwJ = wJ[e*p_Np + j*p_Nq + i];
      for(int fld=0;fld<p_NVfields;++fld){
	dlong qid = e*p_Np*p_NVfields+fld*p_Np+j*p_Nq+i;
	dlong Aqid = base*p_NVfields+fld;
	dfloat r_Aq = r_GwJ*q[qid];
	Aq[Aqid] = r_Aq;
      }
    }
  }
}

// square thread version
@kernel void massPartialAxQuad2D(const dlong Nelements,
				 @restrict const  dlong   *  elementList,
				 @restrict const  dlong   *  GlobalToLocal,
				 @restrict const  dfloat *  wJ,
				 @restrict const  dfloat *  MM,
				 @restrict const  dfloat *  q,
				 @restrict dfloat *  Aq){
  
  for(dlong e=0;e<Nelements;++e;@outer(0)){

    @exclusive dlong element;

    // prefetch q(:,:,:,e) to @shared
    squareThreads{
      element = elementList[e];
      const dlong base = i + j*p_Nq + element*p_Np;
      const dlong id = GlobalToLocal[base];
      
      // assumes w*J built into G entries
      dfloat r_GwJ = wJ[element*p_Np + j*p_Nq + i];

      for(int fld=0;fld<p_NVfields;++fld){
	dfloat qji = q[p_NVfields*id+fld];
	dfloat r_Aq = r_GwJ*qji;
	Aq[base*p_NVfields+fld] = r_Aq;
      }
    }
  }
}



@kernel void massBuildOperatorDiagonalQuad2D(const dlong Nelements,
					     @restrict const  dfloat *  wJ,
					     @restrict const  dfloat *  MM,
					     @restrict dfloat * A){


#define p_two ((dfloat)2)
  
  for(dlong e=0;e<Nelements;++e;@outer(0)){

    for (int m=0;m<p_Nq;++m;@inner(1)) {
      for (int n=0;n<p_Nq;++n;@inner(0)) {

	const dlong nid = e*p_Np + m*p_Nq + n;
	dfloat JW = wJ[e*p_Np + n + m*p_Nq];
	
	for(int fld=0;fld<p_NVfields;++fld){
	  A[p_NVfields*nid+fld] = JW;
	}
      }
    }
  }
}


@kernel void massReciprocal(const dlong N,
			      @restrict const  dfloat *q,
			      @restrict pfloat *invq){

  for(dlong n=0;n<N;++n;@tile(256,@outer,@inner)){
    invq[n] = ((dfloat)1.)/q[n];
  }
}

#define mymax(a,b) ( ( (a) > (b) ) ? (a) : (b) )

@kernel void massScatterQuad2D(const dlong   Nelements,
			       const int clip,
			      @restrict const  dlong   *  GlobalToLocal,
			      @restrict dfloat *  UG,
			      @restrict dfloat *  UL){
  

  for(dlong e=0;e<Nelements;++e;@outer(0)){
    
    @exclusive dlong element;

    for(int n=0;n<p_Np;++n;@inner(0)){
      const dlong base = n + e*p_Np;
      const dlong id = p_NVfields*GlobalToLocal[base];
      const dlong idL = e*p_Np*p_NVfields+n;

      // velocity
      dfloat u = UG[id+0];
      dfloat v = UG[id+1];

      UL[idL+0*p_Np] = u;
      UL[idL+1*p_Np] = v;
      
      if(p_NVfields>2){
	// clip to positive
	dfloat k = UG[id+2];
	dfloat tau = UG[id+3];

	if(clip==1){
	  k   = mymax(k, 0.01*fabs(k));
	  tau = mymax(tau, 0.01*fabs(tau));
	}
	
	UL[idL+2*p_Np] = k;
	UL[idL+3*p_Np] = tau;
      }
    }
  }
}


@kernel void massWeightQuad2D(const dlong   Ngather,
			     @restrict pfloat *wG,
			     @restrict pfloat *UG){
  

  for(int n=0;n<Ngather;++n;@tile(256,@outer(0),@inner(0))){
    dlong id = n*p_NVfields;
    dfloat wn = wG[n];
    for(int fld=0;fld<p_NVfields;++fld){
      UG[id+fld] *= wn;
    }
  }
}

