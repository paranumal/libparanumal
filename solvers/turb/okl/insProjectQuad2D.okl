// use mass weighting
@kernel void insProjectWeightQuad2D(const dlong Nelements,
				    const int Nfilt,
				    @restrict dfloat *projectWeights,
				    @restrict dfloat *u,
				    @restrict dfloat *uL,
				    @restrict dfloat *vL){

  
  for(dlong e=0;e<Nelements;++e;@outer(0)){
    for(int j=0;j<p_Nq;++j;@inner(1)){
      for(int i=0;i<p_Nq;++i;@inner(0)){
	
	const dlong wbase = i + j*p_Nq + e*p_Np;
	const dlong Ubase = i + j*p_Nq + Nfilt*e*p_Np;
	
	dfloat wL = projectWeights[wbase];
	uL[wbase] = wL*u[Ubase+0*p_Np];
	if(Nfilt>1)
	  vL[wbase] = wL*u[Ubase+1*p_Np];
      }
    }
  }
}

// gather from global u and v and scatter to combined local U
@kernel void insProjectScatterQuad2D(const dlong Nelements,
				     const int Nfilt,
				      @restrict dlong *uGlobalToLocal,
				      @restrict dfloat *uG,
				      @restrict dlong *vGlobalToLocal,
				      @restrict dfloat *vG,
				      @restrict dfloat *U){ 

  
  for(dlong e=0;e<Nelements;++e;@outer(0)){
    for(int j=0;j<p_Nq;++j;@inner(1)){
      for(int i=0;i<p_Nq;++i;@inner(0)){

	const dlong base = i + j*p_Nq + e*p_Np;
	const dlong uid = uGlobalToLocal[base];
	
	const dlong Ubase = i + j*p_Nq + Nfilt*e*p_Np;
	if(uid>=0){	  
	  dfloat ue = uG[uid];
	  U[Ubase + 0*p_Np] = ue;
	}

	if(Nfilt>1){
	  const dlong vid = vGlobalToLocal[base];
	  if(vid>=0){	  
	    dfloat ve = vG[vid];
	    U[Ubase + 1*p_Np] = ve;
	  }
	}
      }
    }
  }
}
	  
	  
