#define p_half ((dfloat)0.5)

// // Optimized sizes for @kernel 6, currently best one !!!!
#if p_N==1
#define p_NbV 20
#define p_Nmt 1
#endif

#if p_N==2
#define p_NbV 5
#define p_Nmt 2
#endif

#if p_N==3
#define p_NbV 6
#define p_Nmt 2
#endif

#if p_N==4
#define p_NbV 2
#define p_Nmt 2
#endif

#if p_N==5
#define p_NbV 3
#define p_Nmt 2
#endif

#if p_N==6
#define p_NbV 6
#define p_Nmt 3
#endif

#if p_N==7
#define p_NbV 3
#define p_Nmt 3
#endif

#if p_N==8
#define p_NbV 5
#define p_Nmt 2
#endif

#if p_N==9
#define p_NbV 3
#define p_Nmt 2
#endif

#if p_N==10
#define p_NbV 3
#define p_Nmt 2
#endif


#define insSubcycleAdvectionCubatureVolumeTri2D_stab insSubcycleAdvectionCubatureVolumeTri2D
#define insSubcycleAdvectionCubatureSurfaceTri2D_stab insSubcycleAdvectionCubatureSurfaceTri2D



@kernel void insSubcycleAdvectionCubatureVolumeTri2D_stab(const dlong Nelements,
						     @restrict const  dfloat *  vgeo,
						     @restrict const  dfloat *  cubvgeo,
						     @restrict const  dfloat *  cubD,
						     @restrict const  dfloat *  cubPDT,
						     @restrict const  dfloat *  cubInterp,
						     @restrict const  dfloat *  cubProject,
						     @restrict const  dfloat *  Ue,
						     @restrict const  dfloat *  U,
						     @restrict  dfloat *  RHS){

  for(dlong e=0;e<Nelements;++e;@outer(0)){  // for all elements

    // Hold Flux Vector on Shared
    @shared dfloat  s_U[p_cubNp];
    @shared dfloat  s_V[p_cubNp];
    @shared dfloat s_Ue[p_Np];
    @shared dfloat s_Ve[p_Np];
    @shared dfloat  s_divU[p_cubNp];

    @exclusive dfloat Uflux, Vflux, cdivU;
    @exclusive dfloat drdx, drdy, dsdx, dsdy, volh;
    
    for(int n=0;n<p_cubNp;++n;@inner(0)){     // for all nodes in this element
      if(e<Nelements){
	// prefetch geometric factors (constant on affine triangle)
	drdx = vgeo[e*p_Nvgeo + p_RXID];
	drdy = vgeo[e*p_Nvgeo + p_RYID];
	dsdx = vgeo[e*p_Nvgeo + p_SXID];
	dsdy = vgeo[e*p_Nvgeo + p_SYID];
	volh = vgeo[e*p_Nvgeo + p_VOLHID];

	if(n<p_Np){

	  const dlong id = e*p_Np*p_NVfields + n;
	  
	  const dfloat Uen = Ue[id+0*p_Np];
	  const dfloat Ven = Ue[id+1*p_Np];
	  
	  s_U[n] = U[id+0*p_Np];
	  s_V[n] = U[id+1*p_Np];
	  
	  s_Ue[n] = drdx*Uen + drdy*Ven; // rotate velocity
	  s_Ve[n] = dsdx*Uen + dsdy*Ven; //
	}
      }
    }

    for(int n=0;n<p_cubNp;++n;@inner(0)){     // for all nodes in this element
      dfloat cU = 0,   cV = 0, cUe = 0, cVe = 0;
      dfloat cUr = 0, cUs = 0, cVr = 0, cVs = 0;
      dfloat cUer = 0, cVes = 0;
      
#pragma unroll p_Np
      for(int i=0;i<p_Np;++i){
	const dfloat cIni   = cubInterp[n+i*p_cubNp + 0*p_Np*p_cubNp];
	const dfloat cDr_ni = cubInterp[n+i*p_cubNp + 1*p_Np*p_cubNp];
	const dfloat cDs_ni = cubInterp[n+i*p_cubNp + 2*p_Np*p_cubNp];
	dfloat Ui = s_U[i];
	dfloat Vi = s_V[i];
	dfloat Uei = s_Ue[i];
	dfloat Vei = s_Ve[i];
	cU   += cIni*Ui;
	cV   += cIni*Vi;
	cUe  += cIni*Uei;
	cVe  += cIni*Vei;
	cUr  += cDr_ni*Ui;
	cVr  += cDr_ni*Vi;
	cUer += cDr_ni*Uei;
	cUs  += cDs_ni*Ui;
	cVs  += cDs_ni*Vi;
	cVes += cDs_ni*Vei;
      }

      cdivU  = (drdx*cUr + dsdx*cUs) + (drdy*cVr + dsdy*cVs);
      
      Uflux  = cUe*cUr + cVe*cUs;
      Uflux += p_half*cU*(cUer + cVes);
      
      Vflux  = cUe*cVr + cVe*cVs;
      Vflux += p_half*cV*(cUer + cVes);
    }
    
    for(int n=0;n<p_cubNp;++n;@inner(0)){     // for all nodes in this element
      s_U[n] = Uflux;
      s_V[n] = Vflux;
      s_divU[n] = cdivU;
    }

    for(int n=0;n<p_cubNp;++n;@inner(0)){     // for all nodes in this element
      Uflux = 0;
      Vflux = 0;
      dfloat cdivUr = 0;
      dfloat cdivUs = 0;
      if(n<p_Np){
	for(int i=0;i<p_cubNp;++i){
	  dfloat Pni   = cubProject[n+i*p_Np];
	  dfloat PDrni = cubPDT[n+i*p_Np+0*p_Np*p_cubNp];
	  dfloat PDsni = cubPDT[n+i*p_Np+1*p_Np*p_cubNp];
	  Uflux += Pni*s_U[i];
	  Vflux += Pni*s_V[i];

	  dfloat divUi = s_divU[i];
	  cdivUr += PDrni*divUi;
	  cdivUs += PDsni*divUi;
	}

	dfloat sigmaVol = 0.25*volh; // 2.5e-3;
	Uflux += sigmaVol*(drdx*cdivUr + dsdx*cdivUs);
	Vflux += sigmaVol*(drdy*cdivUr + dsdy*cdivUs);
	
	const dlong id = e*p_Np*p_NVfields+n;
	RHS[id+0*p_Np] = -Uflux; // negate ?
	RHS[id+1*p_Np] = -Vflux; // negate ?
      }
    }
  }
}


// Optimized sizes for @kernel 5
#if p_N==1
#define p_NblockS4 8
#define p_NnodesS4 4
#endif

#if p_N==2
#define p_NblockS4 2
#define p_NnodesS4 3
#endif

#if p_N==3
#define p_NblockS4 4
#define p_NnodesS4 5
#endif

#if p_N==4
#define p_NblockS4 2
#define p_NnodesS4 3
#endif

#if p_N==5
#define p_NblockS4 4
#define p_NnodesS4 5
#endif

#if p_N==6
#define p_NblockS4 4
#define p_NnodesS4 5
#endif

#if p_N==7
#define p_NblockS4 5
#define p_NnodesS4 2
#endif

#if p_N==8
#define p_NblockS4 1
#define p_NnodesS4 4
#endif

#if p_N==9
#define p_NblockS4 3
#define p_NnodesS4 2
#endif

#if p_N==10
#define p_NblockS4 2
#define p_NnodesS4 3
#endif



@kernel void insSubcycleAdvectionCubatureSurfaceTri2D_stab(const dlong Nelements,
						      @restrict const  dfloat *  vgeo,
						      @restrict const  dfloat *  sgeo,
						      @restrict const  dfloat *  intInterp, // interpolate to integration nodes
						      @restrict const  dfloat *  intLIFT, // lift from integration to interpolation nodes
						      @restrict const  dlong  *  vmapM,
						      @restrict const  dlong  *  vmapP,
						      @restrict const  int    *  EToB,
						      const dfloat time,
						      @restrict const  dfloat *  intx, // integration nodes
						      @restrict const  dfloat *  inty,
						      @restrict const  dfloat *  intz,
						      const dfloat nu,
						      @restrict const  dfloat *  Ue,
						      @restrict const  dfloat *  U,
						      @restrict  dfloat *  RHS){
  // for all elements
  for(dlong eo=0;eo<Nelements;eo+=(p_NblockS4*p_NnodesS4);@outer(0)){

    // @shared storage
    @shared dfloat s_U[p_NnodesS4][p_NblockS4][p_intNfpNfaces];
    @shared dfloat s_V[p_NnodesS4][p_NblockS4][p_intNfpNfaces];

    #define s_iFluxU s_U // Reuse @shared memory arrays
    #define s_iFluxV s_V

    @exclusive dfloat r_iUM[p_NnodesS4];
    @exclusive dfloat r_iVM[p_NnodesS4];
    @exclusive dfloat r_iUdM[p_NnodesS4], r_iUdP[p_NnodesS4];
    @exclusive dfloat r_iVdM[p_NnodesS4], r_iVdP[p_NnodesS4];

    @exclusive dlong qbaseM[p_NnodesS4], qbaseP[p_NnodesS4];
    @exclusive int face;

    // Loop for minus traces
    // for all face nodes of all elements
    for(int es=0;es<p_NblockS4;++es;@inner(1)){
      for(int n=0;n<p_cubMaxNodes;++n;@inner(0)){
        if(n<(p_Nfaces*p_Nfp)){
          #pragma unroll p_NnodesS4
          for (int em=0;em<p_NnodesS4;++em){
            const dlong e = em*p_NblockS4 + es + eo;
            if (e<Nelements) {
              // indices of negative and positive traces of face node
              const dlong id  = e*p_Nfp*p_Nfaces + n;
              const dlong idM = vmapM[id];
              const dlong idP = vmapP[id];

              // load traces
              const dlong eM = e;
              const dlong eP = idP/p_Np;
              const int vidM = idM%p_Np;
              const int vidP = idP%p_Np;

              qbaseM[em] = eM*p_Np*p_NVfields + vidM;
              qbaseP[em] = eP*p_Np*p_NVfields + vidP;

              // load negative and positive trace node values of velocity
              s_U[em][es][n] = Ue[qbaseM[em]+0*p_Np];
              s_V[em][es][n] = Ue[qbaseM[em]+1*p_Np];
            }
          }
        }
      }
    }


    // interpolate to surface integration nodes
    for(int es=0;es<p_NblockS4;++es;@inner(1)){
      for(int n=0;n<p_cubMaxNodes;++n;@inner(0)){
        if(n<(p_Nfaces*p_intNfp)){
          face = n/p_intNfp; // find face that owns this integration node

          #pragma unroll p_NnodesS4
          for (int em=0;em<p_NnodesS4;++em){
            r_iUM[em]  = 0.f;
	    r_iVM[em]  = 0.f;
          }

          // local block interpolation (face nodes to integration nodes)
          #pragma unroll p_Nfp
          for(int m=0;m<p_Nfp;++m){
            const dfloat iInm = intInterp[n+m*p_Nfaces*p_intNfp];
            const int fm = face*p_Nfp+m;

            #pragma unroll p_NnodesS4
            for (int em=0;em<p_NnodesS4;++em){
              r_iUM[em]  += iInm*s_U[em][es][fm];
	      r_iVM[em]  += iInm*s_V[em][es][fm];
            }
          }
        }
      }
    }

    // for all face nodes of all elements
    for(int es=0;es<p_NblockS4;++es;@inner(1)){
      for(int n=0;n<p_cubMaxNodes;++n;@inner(0)){
        if(n<(p_Nfaces*p_Nfp)){
          #pragma unroll p_NnodesS4
          for (int em=0;em<p_NnodesS4;++em){
            const dlong e = em*p_NblockS4 + es + eo;
            if (e<Nelements) {
              // load negative and positive trace node values of advection field
              s_U[em][es][n] = U[qbaseM[em]+0*p_Np];
              s_V[em][es][n] = U[qbaseP[em]+0*p_Np];
            }
          }
        }
      }
    }


    // interpolate to surface integration nodes
    for(int es=0;es<p_NblockS4;++es;@inner(1)){
      for(int n=0;n<p_cubMaxNodes;++n;@inner(0)){
        if(n<(p_Nfaces*p_intNfp)){
          #pragma unroll p_NnodesS4
          for (int em=0;em<p_NnodesS4;++em){
            r_iUdM[em]  = 0.f;
            r_iUdP[em]  = 0.f;
          }

          // local block interpolation (face nodes to integration nodes)
          #pragma unroll p_Nfp
          for(int m=0;m<p_Nfp;++m){
            const dfloat iInm = intInterp[n+m*p_Nfaces*p_intNfp];
            const int fm = face*p_Nfp+m;

            #pragma unroll p_NnodesS4
            for (int em=0;em<p_NnodesS4;++em){
              r_iUdM[em]  += iInm*s_U[em][es][fm];
              r_iUdP[em]  += iInm*s_V[em][es][fm];
            }
          }
        }
      }
    }

    // for all face nodes of all elements
    for(int es=0;es<p_NblockS4;++es;@inner(1)){
      for(int n=0;n<p_cubMaxNodes;++n;@inner(0)){
        if(n<(p_Nfaces*p_Nfp)){
          #pragma unroll p_NnodesS4
          for (int em=0;em<p_NnodesS4;++em){
            const dlong e = em*p_NblockS4 + es + eo;
            if (e<Nelements) {
              // load negative and positive trace node values of advection field
              s_U[em][es][n] = U[qbaseM[em]+1*p_Np];
              s_V[em][es][n] = U[qbaseP[em]+1*p_Np];
            }
          }
        }
      }
    }


    // interpolate to surface integration nodes
    for(int es=0;es<p_NblockS4;++es;@inner(1)){
      for(int n=0;n<p_cubMaxNodes;++n;@inner(0)){
        if(n<(p_Nfaces*p_intNfp)){
          #pragma unroll p_NnodesS4
          for (int em=0;em<p_NnodesS4;++em){
            r_iVdM[em]  = 0.f;
            r_iVdP[em]  = 0.f;
          }

          // local block interpolation (face nodes to integration nodes)
          #pragma unroll p_Nfp
          for(int m=0;m<p_Nfp;++m){
            const dfloat iInm = intInterp[n+m*p_Nfaces*p_intNfp];
            const int fm = face*p_Nfp+m;

            #pragma unroll p_NnodesS4
            for (int em=0;em<p_NnodesS4;++em){
              r_iVdM[em]  += iInm*s_U[em][es][fm];
              r_iVdP[em]  += iInm*s_V[em][es][fm];
            }
          }
        }
      }
    }

    // Use traces to compuite and store flux
    for(int es=0;es<p_NblockS4;++es;@inner(1)){
      for(int n=0;n<p_cubMaxNodes;++n;@inner(0)){
        #pragma unroll p_NnodesS4
        for (int em=0;em<p_NnodesS4;++em){
          const dlong e = em*p_NblockS4 + es + eo;
          if((e<Nelements)&&(n<(p_Nfaces*p_intNfp))){
            // load surface geofactors for this face
            const dlong sid    = p_Nsgeo*(e*p_Nfaces+face);
            const dfloat nx    = sgeo[sid+p_NXID];
            const dfloat ny    = sgeo[sid+p_NYID];
            const dfloat sJ    = sgeo[sid+p_SJID];
            const dfloat invJ  = sgeo[sid+p_IJID];
	    const dfloat surfH = sgeo[sid+p_MAXHID];

            // apply boundary conditions
            const int bc = EToB[face+p_Nfaces*e];
            if(bc>0){
	      dfloat ndotU = nx*r_iUM[em] + ny*r_iVM[em];
              insVelocityDirichletConditions2D(bc,ndotU, nu,time, intx[n+e*p_Nfaces*p_intNfp], inty[n+e*p_Nfaces*p_intNfp], nx, ny, r_iUdM[em],r_iVdM[em], &(r_iUdP[em]), &(r_iVdP[em]));
            }

            // Find max normal velocity on the face
            const dfloat unmax   = fabs(nx*r_iUM[em] + ny*r_iVM[em]);

	    const dfloat sigmaSurf = surfH;
	    const dfloat ndotdUd = nx*(r_iUdM[em]-r_iUdP[em]) + ny*(r_iVdM[em]-r_iVdP[em]);
	    
            // evaluate "flux" terms: LLF
            const dfloat sc = 0.5f*invJ*sJ;

	    const dfloat ndotdUe = nx*r_iUM[em] + ny*r_iVM[em];// rely on C0 advection velocity
            // bad notation here //
            s_iFluxU[em][es][n] = sc*( (ndotdUe-unmax)*(r_iUdP[em] - r_iUdM[em]) + sigmaSurf*nx*ndotdUd);
            s_iFluxV[em][es][n] = sc*( (ndotdUe-unmax)*(r_iVdP[em] - r_iVdM[em]) + sigmaSurf*ny*ndotdUd);
          }
        }
      }
    }


    // lift from surface integration to volume nodes
    for(int es=0;es<p_NblockS4;++es;@inner(1)){
      for(int n=0;n<p_cubMaxNodes;++n;@inner(0)){
        if(n<p_Np){
          #pragma unroll p_NnodesS4
          for (int em=0;em<p_NnodesS4;++em){
            r_iUM[em] = 0.0;
            r_iVM[em] = 0.0;
          }

          #pragma unroll p_intNfpNfaces
          for(int m=0;m<p_intNfpNfaces;++m){
            const dfloat L = intLIFT[n+m*p_Np];

            #pragma unroll p_NnodesS4
            for (int em=0;em<p_NnodesS4;++em){
              r_iUM[em] += L*s_U[em][es][m];
              r_iVM[em] += L*s_V[em][es][m];
            }
          }

          #pragma unroll p_NnodesS4
          for (int em=0;em<p_NnodesS4;++em){
            const dlong e = em*p_NblockS4 + es + eo;
            if(e<Nelements) {
              const dlong id = n + p_NVfields*p_Np*e;
              // prefemch volume rhs
              RHS[id+0*p_Np] -= r_iUM[em];
              RHS[id+1*p_Np] -= r_iVM[em];
            }
          }
        }
      }
    }
  }
}
#undef s_iFluxU
#undef s_iFluxV

