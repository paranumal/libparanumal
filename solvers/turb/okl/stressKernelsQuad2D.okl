#define p_two ((dfloat)2)

// hex @kernel for screened coulomb potential mat-vec
#define squareThreads				\
  for(int j=0; j<p_Nq; ++j; @inner(1))		\
    for(int i=0; i<p_Nq; ++i; @inner(0))



// square thread version
@kernel void stressPartialAxQuad2D(const dlong Nelements,
                                   @restrict const  dlong   *  elementList,
                                   @restrict const  dlong   *  GlobalToLocal,
                                   @restrict const  dfloat *  nut,
                                   @restrict const  dfloat *  wJ,
                                   @restrict const  dfloat *  vgeo,
                                   @restrict const  dfloat *  DT,
                                   @restrict const  dfloat *  S,
                                   @restrict const  dfloat *  MM,
                                   const dfloat   lambda,
                                   @restrict const  dfloat *  q,
                                   @restrict dfloat *  Aq){

  for(dlong e=0;e<Nelements;++e;@outer(0)){

    @shared dfloat s_u[p_Nq][p_Nq];
    @shared dfloat s_v[p_Nq][p_Nq];
    @shared dfloat s_DT[p_Nq][p_Nq];

    // oh dear
    @shared dfloat s_tmpur[p_Nq][p_Nq];
    @shared dfloat s_tmpus[p_Nq][p_Nq];
    @shared dfloat s_tmpvr[p_Nq][p_Nq];
    @shared dfloat s_tmpvs[p_Nq][p_Nq];    
    
    @exclusive dlong element;
    @exclusive dfloat r_Aq[p_Nfields];

    // prefetch q(:,:,:,e) to @shared
    squareThreads{
      element = elementList[e];
      const dlong base = i + j*p_Nq + element*p_Np;
      const dlong id = GlobalToLocal[base];

      s_u[j][i] = (id!=-1) ? q[id*p_Nfields+0] : 0.0;
      s_v[j][i] = (id!=-1) ? q[id*p_Nfields+1] : 0.0;

      // fetch DT to @shared
      s_DT[j][i] = DT[j*p_Nq+i];
    }

    @barrier();

    squareThreads{

      // assumes w*J built into G entries
      const dlong id = element*p_Np + j*p_Nq + i;
      dfloat r_nut = nut[id];
      
      const dlong base = element*p_Nvgeo*p_Np + j*p_Nq + i;
      dfloat rx = vgeo[base+p_RXID*p_Np];
      dfloat ry = vgeo[base+p_RYID*p_Np];
      dfloat sx = vgeo[base+p_SXID*p_Np];
      dfloat sy = vgeo[base+p_SYID*p_Np];
      dfloat r_wJ = vgeo[base+p_JWID*p_Np];

      dfloat ur = 0, vr = 0, us= 0, vs = 0;

#pragma unroll p_Nq
      for(int n=0; n<p_Nq; ++n){
	dfloat Din = s_DT[i][n];
	dfloat Djn = s_DT[j][n];	
	ur += Din*s_u[j][n];
	vr += Din*s_v[j][n];
	us += Djn*s_u[n][i];
	vs += Djn*s_v[n][i];
      }

      dfloat ux = rx*ur + sx*us;
      dfloat uy = ry*ur + sy*us;
      dfloat vx = rx*vr + sx*vs;
      dfloat vy = ry*vr + sy*vs;
      
      r_Aq[0] = r_wJ*lambda*s_u[j][i];
      r_Aq[1] = r_wJ*lambda*s_v[j][i];

      r_wJ *= r_nut;

      dfloat tmpur = rx*(p_two*ux) + ry*(uy+vx);
      dfloat tmpus = sx*(p_two*ux) + sy*(uy+vx);
      dfloat tmpvr = rx*(uy+vx) + ry*(p_two*vy);
      dfloat tmpvs = sx*(uy+vx) + sy*(p_two*vy);

      s_tmpur[j][i] = r_wJ*tmpur;
      s_tmpus[j][i] = r_wJ*tmpus;
      s_tmpvr[j][i] = r_wJ*tmpvr;
      s_tmpvs[j][i] = r_wJ*tmpvs;
    }

    @barrier();
    
    squareThreads{

      dfloat tmpu = 0, tmpv = 0;

#pragma unroll p_Nq
      for(int n=0;n<p_Nq;++n) {
	dfloat Dni = s_DT[n][i];
	dfloat Dnj = s_DT[n][j];
	tmpu += Dni*s_tmpur[j][n];
	tmpv += Dni*s_tmpvr[j][n];
	tmpu += Dnj*s_tmpus[n][i];
	tmpv += Dnj*s_tmpvs[n][i];
      }

      /*
	\sum_j d_j ( nu (d_j u_i + d_i u_j ))
	=> -\sum_j (d_j phi, nu (d_j u_i + d_i u_j ))
	
	Dx'*nu*Dx*u + Dy'*nu*Dy*u + Dx'*nu*Dx*u + Dy'*nu*Dx*v
	Dx'*nu*Dx*v + Dy'*nu*Dy*v + Dx'*nu*Dy*u + Dy'*nu*Dy*v
	
      */

      r_Aq[0] += tmpu;
      r_Aq[1] += tmpv;
      
      const dlong base = p_Nfields*(element*p_Np + j*p_Nq + i);
      for(int fld=0;fld<p_Nfields;++fld){
	Aq[base+fld] = r_Aq[fld];
      }
    }
  }
}



@kernel void stressReciprocal(const dlong N,
			      @restrict const  dfloat *q,
			      @restrict pfloat *invq){

  for(dlong n=0;n<N;++n;@tile(256,@outer,@inner)){
    invq[n] = ((dfloat)1.)/q[n];
  }
}


@kernel void stressBuildOperatorDiagonalQuad2D(const dlong Nelements,
					       @restrict const  dfloat *  nut,
					       @restrict const  dlong *  mapB,
					       const dfloat neumannBoost,
					       @restrict const  dfloat *  wJ,
					       @restrict const  dfloat *  vgeo,
					       @restrict const  dfloat *  DT,
					       @restrict const  dfloat *  S,
					       @restrict const  dfloat *  MM,
					       const dfloat   lambda,
					       @restrict dfloat * A){


  /*
    \sum_j d_j ( nu (d_j u_i + d_i u_j ))
    => -\sum_j (d_j phi, nu (d_j u_i + d_i u_j ))
    
    [2.*Dx'*nu*Dx*u + Dy'*nu*Dy*u] + Dy'*nu*Dx*v
    Dx'*nu*Dy*u + [Dx'*nu*Dx*v + 2.*Dy'*nu*Dy*v]
    
  */

#define p_two ((dfloat)2)
  
  
  for(dlong e=0;e<Nelements;++e;@outer(0)){

    @shared dfloat s_D[p_Nq][p_Nq];

    for (int m=0;m<p_Nq;++m;@inner(1)) {
      for (int n=0;n<p_Nq;++n;@inner(0)) {
	s_D[m][n] = DT[m*p_Nq+n];
      }
    }
    
    for (int m=0;m<p_Nq;++m;@inner(1)) {
      for (int n=0;n<p_Nq;++n;@inner(0)) {
	dfloat Au = 0, Av = 0;

	const dlong nid = e*p_Np + m*p_Nq + n;
	const dfloat fac = p_two;
	// Eventually set this to 2
	const int bc = mapB[nid];

	// make this simpler
        if (bc!=1){
	  dlong vbase = e*p_Np*p_Nvgeo;

          for (int k=0;k<p_Nq;k++) {
            int id = k+m*p_Nq;
	    dfloat Dkn = s_D[k][n];
	    dfloat rx = vgeo[vbase + id + p_RXID*p_Np];
	    dfloat ry = vgeo[vbase + id + p_RYID*p_Np];
	    dfloat wJ = vgeo[vbase + id + p_JWID*p_Np];	    
	    dfloat nut_km = nut[e*p_Np+id];

	    dfloat uGrr = (fac*rx*rx + ry*ry)*nut_km*wJ;
            Au += uGrr*Dkn*Dkn; // strided for gather
	    
	    dfloat vGrr = (fac*ry*ry + rx*rx)*nut_km*wJ;
	    Av += vGrr*Dkn*Dkn;
          }


          for (int k=0;k<p_Nq;k++) {
            int id = n+k*p_Nq;
	    dfloat Dkm = s_D[k][m];
	    dfloat sx = vgeo[vbase + id + p_SXID*p_Np];
	    dfloat sy = vgeo[vbase + id + p_SYID*p_Np];
	    dfloat wJ = vgeo[vbase + id + p_JWID*p_Np];	    
	    dfloat nut_nk = nut[e*p_Np+id];
	    
	    dfloat uGss = (fac*sx*sx + sy*sy)*nut_nk*wJ;
            Au += uGss*Dkm*Dkm; // strided for gather
	    
	    dfloat vGss = (fac*sy*sy + sx*sx)*nut_nk*wJ;
	    Av += vGss*Dkm*Dkm;
          }

	  {
            int id = n+m*p_Nq;
	    dfloat Dnn = s_D[n][n];
	    dfloat Dmm = s_D[m][m];
	    dfloat rx = vgeo[vbase + id + p_RXID*p_Np];
	    dfloat ry = vgeo[vbase + id + p_RYID*p_Np];
	    dfloat sx = vgeo[vbase + id + p_SXID*p_Np];
	    dfloat sy = vgeo[vbase + id + p_SYID*p_Np];
	    dfloat wJ = vgeo[vbase + id + p_JWID*p_Np];	    
	    dfloat nut_nm = nut[e*p_Np+id];

	    // check this
	    dfloat uGrs = p_two*(fac*rx*sx + ry*sy)*nut_nm*wJ;
            Au += uGrs*Dnn*Dmm; // strided for gather
	    
	    dfloat vGrs = p_two*(fac*ry*sy + rx*sx)*nut_nm*wJ;
	    Av += vGrs*Dnn*Dmm;
	    
	    // do not need off diagonal blocks
	  }
	  
	  dfloat JW = vgeo[vbase + n + m*p_Nq + p_JWID*p_Np];
          Au += JW*lambda;
	  Av += JW*lambda;
	  
        } else {
          Au = 1; //just put a 1 so A is invertable
	  Av = 1;
        }
      
	//add the rank boost for the allNeumann Poisson problem
	if (neumannBoost) {
	  if(bc!=1) { //dont fill rows for masked nodes
	    Au += neumannBoost;
	    Av += neumannBoost;
	  }
	}
	
	A[p_Nfields*nid+0] = Au;
	A[p_Nfields*nid+1] = Av;
      }
    }
  }
}

