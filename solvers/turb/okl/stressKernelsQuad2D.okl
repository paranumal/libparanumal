#define p_one ((dfloat)1.)
#define p_two ((dfloat)2.)

// hex @kernel for screened coulomb potential mat-vec
#define squareThreads				\
  for(int j=0; j<p_Nq; ++j; @inner(1))		\
    for(int i=0; i<p_Nq; ++i; @inner(0))



// square thread version
@kernel void stressPartialAxQuad2D(const dlong Nelements,
                                   @restrict const  dlong   *  elementList,
                                   @restrict const  dlong   *  GlobalToLocal,
                                   @restrict const  dfloat *  nut,
                                   @restrict const  dfloat *  wJ,
                                   @restrict const  dfloat *  vgeo,
                                   @restrict const  dfloat *  DT,
                                   @restrict const  dfloat *  S,
                                   @restrict const  dfloat *  MM,
				   @restrict const  dfloat *  stiffDiagonal,	
                                   const dfloat   lambda,
                                   @restrict const  dfloat *  q,
                                   @restrict dfloat *  Aq){

  for(dlong e=0;e<Nelements;++e;@outer(0)){

    @shared dfloat s_u[p_Nq][p_Nq];
    @shared dfloat s_v[p_Nq][p_Nq];
    @shared dfloat s_k[p_Nq][p_Nq];
    @shared dfloat s_tau[p_Nq][p_Nq];
    @shared dfloat s_DT[p_Nq][p_Nq];

    // oh dear
    @shared dfloat s_tmpur[p_Nq][p_Nq];
    @shared dfloat s_tmpus[p_Nq][p_Nq];
    @shared dfloat s_tmpvr[p_Nq][p_Nq];
    @shared dfloat s_tmpvs[p_Nq][p_Nq];
    @shared dfloat s_tmpkr[p_Nq][p_Nq];
    @shared dfloat s_tmpks[p_Nq][p_Nq];
    @shared dfloat s_tmptaur[p_Nq][p_Nq];
    @shared dfloat s_tmptaus[p_Nq][p_Nq];    
    
    @exclusive dlong element;
    @exclusive dfloat r_Aq[p_Nfields];

    // prefetch q(:,:,:,e) to @shared
    squareThreads{
      element = elementList[e];
      const dlong base = i + j*p_Nq + element*p_Np;
      const dlong id = GlobalToLocal[base];

      s_u[j][i]   = (id!=-1) ? q[id*p_Nfields+0] : 0.0;
      s_v[j][i]   = (id!=-1) ? q[id*p_Nfields+1] : 0.0;
      s_k[j][i]   = (id!=-1) ? q[id*p_Nfields+2] : 0.0;
      s_tau[j][i] = (id!=-1) ? q[id*p_Nfields+3] : 0.0;      

      // fetch DT to @shared
      s_DT[j][i] = DT[j*p_Nq+i];
    }

    @barrier();

    squareThreads{

      // assumes w*J built into G entries
      const dlong id = element*p_Np + j*p_Nq + i;
      dfloat r_nut = nut[id];
      
      const dlong base = element*p_Nvgeo*p_Np + j*p_Nq + i;
      dfloat rx = vgeo[base+p_RXID*p_Np];
      dfloat ry = vgeo[base+p_RYID*p_Np];
      dfloat sx = vgeo[base+p_SXID*p_Np];
      dfloat sy = vgeo[base+p_SYID*p_Np];
      dfloat r_wJ = vgeo[base+p_JWID*p_Np];

      dfloat ur = 0, vr = 0, us= 0, vs = 0;
      dfloat kr = 0, taur = 0, ks= 0, taus = 0;

#pragma unroll p_Nq
      for(int n=0; n<p_Nq; ++n){
	dfloat Din = s_DT[i][n];
	ur += Din*s_u[j][n];
	vr += Din*s_v[j][n];
	kr += Din*s_k[j][n];
	taur += Din*s_tau[j][n];
      }
      
#pragma unroll p_Nq
      for(int n=0; n<p_Nq; ++n){
	dfloat Djn = s_DT[j][n];	
	us += Djn*s_u[n][i];
	vs += Djn*s_v[n][i];
	ks += Djn*s_k[n][i];
	taus += Djn*s_tau[n][i];
      }

      dfloat ux = rx*ur + sx*us;
      dfloat uy = ry*ur + sy*us;
      dfloat vx = rx*vr + sx*vs;
      dfloat vy = ry*vr + sy*vs;

      dfloat kx = rx*kr + sx*ks;
      dfloat ky = ry*kr + sy*ks;
      dfloat taux = rx*taur + sx*taus;
      dfloat tauy = ry*taur + sy*taus;
      
      r_Aq[0] = r_wJ*lambda*s_u[j][i];
      r_Aq[1] = r_wJ*lambda*s_v[j][i];
      r_Aq[2] = r_wJ*lambda*s_k[j][i];
      r_Aq[3] = r_wJ*lambda*s_tau[j][i];

      //      add k-tau penalties here
      dfloat stiffDiagK = stiffDiagonal[element*p_Np*2 + j*p_Nq+i];
      dfloat stiffDiagTau = stiffDiagonal[element*p_Np*2 + j*p_Nq+i + p_Np];

      r_Aq[2] += stiffDiagK*s_k[j][i];
      r_Aq[3] += stiffDiagTau*s_tau[j][i];
      
      dfloat tmpur = rx*(p_two*ux) + ry*(uy+vx);
      dfloat tmpus = sx*(p_two*ux) + sy*(uy+vx);
      dfloat tmpvr = rx*(uy+vx) + ry*(p_two*vy);
      dfloat tmpvs = sx*(uy+vx) + sy*(p_two*vy);

      dfloat tmpkr = rx*kx + ry*ky;
      dfloat tmpks = sx*kx + sy*ky;
      dfloat tmptaur = rx*taux + ry*tauy;
      dfloat tmptaus = sx*taux + sy*tauy;

      dfloat nuU   = p_one + r_nut*p_invNu;
      dfloat nuK   = p_one + p_invSigmaK*(r_nut*p_invNu);
      dfloat nuTau = p_one + p_invSigmaTau*(r_nut*p_invNu);

      dfloat divU = ux + vy;
      dfloat tauVol = 100.*divU; // 0.*divU*(r_wJ*tauVol);
      
      s_tmpur[j][i] = r_wJ*(nuU*tmpur + rx*tauVol);
      s_tmpus[j][i] = r_wJ*(nuU*tmpus + sx*tauVol);
      s_tmpvr[j][i] = r_wJ*(nuU*tmpvr + ry*tauVol);
      s_tmpvs[j][i] = r_wJ*(nuU*tmpvs + sy*tauVol);

      // divergence condition here
#if 0
      dfloat divU = ux + vy;
      dfloat tauVol = 0.*divU*(r_wJ*tauVol);
      s_tmpur[j][i] += rx*tauVol;
      s_tmpus[j][i] += sx*tauVol;
      s_tmpvr[j][i] += ry*tauVol;
      s_tmpvs[j][i] += sy*tauVol;
#endif
      
      s_tmpkr[j][i] = (nuK*r_wJ)*tmpkr;
      s_tmpks[j][i] = (nuK*r_wJ)*tmpks;
      s_tmptaur[j][i] = (nuTau*r_wJ)*tmptaur;
      s_tmptaus[j][i] = (nuTau*r_wJ)*tmptaus;
    }

    @barrier();
    
    squareThreads{

      dfloat tmpu = 0, tmpv = 0, tmpk = 0, tmptau = 0;

#pragma unroll p_Nq
      for(int n=0;n<p_Nq;++n) {
	dfloat Dni = s_DT[n][i];
	tmpu += Dni*s_tmpur[j][n];
	tmpv += Dni*s_tmpvr[j][n];
	tmpk += Dni*s_tmpkr[j][n];
	tmptau += Dni*s_tmptaur[j][n];
      }

#pragma unroll p_Nq
      for(int n=0;n<p_Nq;++n) {
	dfloat Dnj = s_DT[n][j];
	tmpu += Dnj*s_tmpus[n][i];
	tmpv += Dnj*s_tmpvs[n][i];
	tmpk += Dnj*s_tmpks[n][i];
	tmptau += Dnj*s_tmptaus[n][i];
      }

      /*
	\sum_j d_j ( nu (d_j u_i + d_i u_j ))
	=> -\sum_j (d_j phi, nu (d_j u_i + d_i u_j ))
	
	Dx'*nu*Dx*u + Dy'*nu*Dy*u + Dx'*nu*Dx*u + Dy'*nu*Dx*v
	Dx'*nu*Dx*v + Dy'*nu*Dy*v + Dx'*nu*Dy*u + Dy'*nu*Dy*v
	
      */

      r_Aq[0] += tmpu;
      r_Aq[1] += tmpv;
#if 1
      r_Aq[2] += tmpk;
      r_Aq[3] += tmptau;
#endif
      const dlong base = p_Nfields*(element*p_Np + j*p_Nq + i);
      for(int fld=0;fld<p_Nfields;++fld){
	Aq[base+fld] = r_Aq[fld];
      }
    }
  }
}



@kernel void stressReciprocal(const dlong N,
			      @restrict const  dfloat *q,
			      @restrict pfloat *invq){

  for(dlong n=0;n<N;++n;@tile(256,@outer,@inner)){
    invq[n] = ((dfloat)1.)/q[n];
  }
}


@kernel void stressBuildOperatorDiagonalQuad2D(const dlong Nelements,
					       @restrict const  dfloat *  nut,
					       @restrict const  dlong *  mapB,
					       const dfloat neumannBoost,
					       @restrict const  dfloat *  wJ,
					       @restrict const  dfloat *  vgeo,
					       @restrict const  dfloat *  DT,
					       @restrict const  dfloat *  S,
					       @restrict const  dfloat *  MM,
					       const dfloat   lambda,
					       @restrict dfloat *stiffDiagonal,
					       @restrict dfloat * A){


  /*
    \sum_j d_j ( nu (d_j u_i + d_i u_j ))
    => -\sum_j (d_j phi, nu (d_j u_i + d_i u_j ))
    
    [2.*Dx'*nu*Dx*u + Dy'*nu*Dy*u] + Dy'*nu*Dx*v
    Dx'*nu*Dy*u + [Dx'*nu*Dx*v + 2.*Dy'*nu*Dy*v]
    
  */

#define p_two ((dfloat)2)
  
  
  for(dlong e=0;e<Nelements;++e;@outer(0)){

    @shared dfloat s_D[p_Nq][p_Nq];

    for (int m=0;m<p_Nq;++m;@inner(1)) {
      for (int n=0;n<p_Nq;++n;@inner(0)) {
	s_D[m][n] = DT[m*p_Nq+n];
      }
    }
    
    for (int m=0;m<p_Nq;++m;@inner(1)) {
      for (int n=0;n<p_Nq;++n;@inner(0)) {
	dfloat Au = 0, Av = 0, Ak = 0, Atau = 0;

	const dlong nid = e*p_Np + m*p_Nq + n;
	const dfloat fac = p_two;
	// Eventually set this to 2
	const int bc = mapB[nid];

	// make this simpler
        if (bc!=1){
	  dlong vbase = e*p_Np*p_Nvgeo;

          for (int k=0;k<p_Nq;k++) {
            int id = k+m*p_Nq;
	    dfloat Dkn = s_D[k][n];
	    dfloat rx = vgeo[vbase + id + p_RXID*p_Np];
	    dfloat ry = vgeo[vbase + id + p_RYID*p_Np];
	    dfloat wJ = vgeo[vbase + id + p_JWID*p_Np];	    

	    dfloat r_nut = nut[e*p_Np+id];
	    dfloat nuU   = p_one + r_nut*p_invNu;
	    dfloat nuK   = p_one + p_invSigmaK*(r_nut*p_invNu);
	    dfloat nuTau = p_one + p_invSigmaTau*(r_nut*p_invNu);

	    dfloat gtmpu = wJ*(fac*rx*rx + ry*ry);
	    dfloat gtmpv = wJ*(fac*ry*ry + rx*rx);
	    dfloat gtmpkTau = wJ*(rx*rx+ry*ry);

	    dfloat uGrr = gtmpu*nuU;
	    dfloat tmp = Dkn*Dkn;
            Au += uGrr*tmp; // strided for gather
	    
	    dfloat vGrr = gtmpv*nuU;
	    Av += vGrr*tmp;

	    dfloat kGrr = gtmpkTau*nuK;
	    Ak += kGrr*tmp;

	    dfloat tauGrr = gtmpkTau*nuTau;
	    Atau += tauGrr*tmp;
          }


          for (int k=0;k<p_Nq;k++) {
            int id = n+k*p_Nq;
	    dfloat Dkm = s_D[k][m];
	    dfloat sx = vgeo[vbase + id + p_SXID*p_Np];
	    dfloat sy = vgeo[vbase + id + p_SYID*p_Np];
	    dfloat wJ = vgeo[vbase + id + p_JWID*p_Np];	    

	    dfloat r_nut = nut[e*p_Np+id];
	    dfloat nuU   = p_one + r_nut*p_invNu;
	    dfloat nuK   = p_one + p_invSigmaK*(r_nut*p_invNu);
	    dfloat nuTau = p_one + p_invSigmaTau*(r_nut*p_invNu);

	    dfloat gtmpu = wJ*(fac*sx*sx + sy*sy);
	    dfloat gtmpv = wJ*(fac*sy*sy + sx*sx);
	    dfloat gtmpkTau = wJ*(sx*sx+sy*sy);
	    dfloat uGss = gtmpu*nuU;

	    dfloat tmp = Dkm*Dkm;
            Au += uGss*tmp; // strided for gather
	    
	    dfloat vGss = gtmpv*nuU;
	    Av += vGss*tmp;

	    dfloat kGss = gtmpkTau*nuK;
	    Ak += kGss*tmp;

	    dfloat tauGss = gtmpkTau*nuTau;
	    Atau += tauGss*tmp;
          }

	  // cross terms
	  {
            int id = n+m*p_Nq;
	    dfloat Dnn = s_D[n][n];
	    dfloat Dmm = s_D[m][m];
	    dfloat rx = vgeo[vbase + id + p_RXID*p_Np];
	    dfloat ry = vgeo[vbase + id + p_RYID*p_Np];
	    dfloat sx = vgeo[vbase + id + p_SXID*p_Np];
	    dfloat sy = vgeo[vbase + id + p_SYID*p_Np];
	    dfloat wJ = vgeo[vbase + id + p_JWID*p_Np];	    
	    
	    dfloat r_nut = nut[e*p_Np+id];
	    dfloat nuU   = p_one + r_nut*p_invNu;
	    dfloat nuK   = p_one + p_invSigmaK*(r_nut*p_invNu);
	    dfloat nuTau = p_one + p_invSigmaTau*(r_nut*p_invNu);

	    dfloat gtmpu = p_two*wJ*(fac*rx*sx + ry*sy);
	    dfloat gtmpv = p_two*wJ*(fac*ry*sy + rx*sx);
	    dfloat gtmpkTau = p_two*wJ*(rx*sx+sy*sy);
	    dfloat uGrs = gtmpu*nuU;
	    dfloat tmp = Dnn*Dmm;
            Au += uGrs*tmp; // strided for gather
	    
	    dfloat vGrs = gtmpv*nuU;
	    Av += vGrs*tmp;

	    dfloat kGrs = gtmpkTau*nuK;
	    Ak += kGrs*tmp;

	    dfloat tauGrs = gtmpkTau*nuTau;
	    Atau += tauGrs*tmp;
	  }
	  
	  dfloat JW = vgeo[vbase + n + m*p_Nq + p_JWID*p_Np];
          Au += JW*lambda;
	  Av += JW*lambda;
          Ak += JW*lambda;
	  Atau += JW*lambda;
	  
        } else {
          Au = 1; //just put a 1 so A is invertable
	  Av = 1;
	  Ak = 1;
	  Atau = 1;
        }
      
	//add the rank boost for the allNeumann Poisson problem
	if (neumannBoost) {
	  if(bc!=1) { //dont fill rows for masked nodes
	    Au += neumannBoost;
	    Av += neumannBoost;
	    Ak += neumannBoost;
	    Atau += neumannBoost;
	  }
	}

	Ak += stiffDiagonal[e*p_Np*2+m*p_Nq+n + 0*p_Np];
	Atau += stiffDiagonal[e*p_Np*2+m*p_Nq+n + 1*p_Np];
	
	A[p_Nfields*nid+0] = Au;
	A[p_Nfields*nid+1] = Av;
	A[p_Nfields*nid+2] = Ak;
	A[p_Nfields*nid+3] = Atau;

#if 0
	printf("Au=(%g,%g,%g,%g)\n", Au, Av, Ak, Atau);
#endif
	
      }
    }
  }
}

