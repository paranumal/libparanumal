@kernel void insImmersedBoundaryAdvectionPenaltyTet3D(const dlong Nelements,
						      @restrict const  dlong   *  elementList,
						      @restrict const  dfloat *  ibLIFT,
						      @restrict const  dfloat  *  U,
						      @restrict dfloat  *  RHS){
  
  for(dlong e=0;e<Nelements;++e;@outer(0)){

    @shared dfloat s_U[p_Np];
    @shared dfloat s_V[p_Np];
    @shared dfloat s_W[p_Np];
    @exclusive dlong element;

    for(int n=0;n<p_Np;++n;@inner(0)){
      element = elementList[e];
      
      const dlong base = n + element*p_Np*p_dim;
      s_U[n] = -U[base+0*p_Np]; // negate for penalty
      s_V[n] = -U[base+1*p_Np];
      s_W[n] = -U[base+2*p_Np];
    }
    
    
    for(int n=0;n<p_Np;++n;@inner(0)){
      const dfloat *ibLIFTe = ibLIFT+e*p_Np*p_Np;

      // coalesced (up to Np) read
      dfloat URHS = RHS[element*p_Np*p_dim+n+0*p_Np];
      dfloat VRHS = RHS[element*p_Np*p_dim+n+1*p_Np];
      dfloat WRHS = RHS[element*p_Np*p_dim+n+2*p_Np];
      
#pragma unroll p_Np
      for(int m=0;m<p_Np;++m){
	// coalesced up to Np read of ibLIFT
	dfloat LIFTnm = ibLIFTe[n+m*p_Np];
	URHS += LIFTnm*s_U[m];
	VRHS += LIFTnm*s_V[m];
	WRHS += LIFTnm*s_W[m];
      }
      
      // coalesced (up to Np) write
      RHS[element*p_Np*p_dim+n+0*p_Np] = URHS;
      RHS[element*p_Np*p_dim+n+1*p_Np] = VRHS;
      RHS[element*p_Np*p_dim+n+2*p_Np] = WRHS;
    }
  }
}
