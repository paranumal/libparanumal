// compute NU = -div(uxu) using quadrature (weak form)
@kernel void insRelaxationFilterTet3D(const dlong Nelements,
				       @restrict const  dfloat * FILT,
				       @restrict const  dfloat *  U,
				       @restrict  dfloat *  RHS){
  
  for(dlong eo=0;eo<Nelements;eo+=p_NblockV;@outer(0)){  // for all elements

    @shared dfloat s_u[p_NblockV][p_Np];
    @shared dfloat s_v[p_NblockV][p_Np];
    @shared dfloat s_w[p_NblockV][p_Np];

    @exclusive dfloat r_U, r_V, r_W;
    @exclusive dfloat r_origU, r_origV, r_origW;
    @exclusive dlong e;
    
    //fetch the Ue and V values and store in flux arrays in @shared
    for(int es=0;es<p_NblockV;++es;@inner(1)){
      for(int i=0;i<p_Np;++i;@inner(0)){
	
	e = eo+es; // element in block
	if(e<Nelements){
	  const dlong id = e*p_Np*p_NVfields + i;
	  
	  r_origU = U[id+0*p_Np];
	  r_origV = U[id+1*p_Np];
	  r_origW = U[id+2*p_Np];
	    
	  s_u[es][i] = r_origU;
	  s_v[es][i] = r_origV;
	  s_w[es][i] = r_origW;
        }
      }
    }

    for(int es=0;es<p_NblockV;++es;@inner(1)){
      for(int i=0;i<p_Np;++i;@inner(0)){
	r_U  = 0.;
	r_V  = 0.;
	r_W  = 0.;
	
#pragma unroll p_Np
	for (int n=0;n<p_Np;n++) {
	  const dfloat Fin = FILT[i+n*p_Np];
	  r_U += Fin*s_u[es][n];
	  r_V += Fin*s_v[es][n];
	  r_W += Fin*s_w[es][n];
	}
	
	const dlong id = e*p_Np*p_NVfields + i;
	const dfloat tau = 100;
	RHS[id+0*p_Np] -= tau*(r_origU-r_U);
	RHS[id+1*p_Np] -= tau*(r_origV-r_V);
	RHS[id+2*p_Np] -= tau*(r_origW-r_W);
      }
    }
  }
}

