#define surfaceTerms(sk,face,i, j)                                      \
  {									\
    const dlong idM = vmapM[sk];					\
    const dfloat nx = sgeo[sk*p_Nsgeo+p_NXID];				\
    const dfloat ny = sgeo[sk*p_Nsgeo+p_NYID];				\
    const dfloat WsJ = sgeo[sk*p_Nsgeo+p_WSJID];			\
                                                                        \
    dfloat dudxP=0.f, dudyP=0.f, uP=0.f;				\
    dfloat dvdxP=0.f, dvdyP=0.f, vP=0.f;				\
    const int bc = mapB[idM];						\
    if(bc>0) {								\
      dfloat ndotU = 1;							\
      insVelocityDirichletConditions2D(bc, ndotU, nu, time, x[idM], y[idM], nx, ny, 0.f, 0.f, &uP, &vP); \
      insVelocityNeumannConditions2D(bc, nu, time, x[idM], y[idM], nx, ny, 0.f, 0.f, 0.f, 0.f, &dudxP, &dudyP, &dvdxP, &dvdyP);	\
    }									\
                                                                        \
    s_u  [j][i]  = uP;							\
    s_v  [j][i]  = vP;							\
    s_ndu[j][i] -= WsJ*(nx*dudxP + ny*dudyP);				\
    s_ndv[j][i] -= WsJ*(nx*dvdxP + ny*dvdyP);				\
  }


// compute RHS = MM*RHS/nu + BCdata
// and split fields to separate arrays
@kernel void insStressRhsQuad2D(const dlong Nelements,
				@restrict const  dfloat *  wJ,
				@restrict const  dfloat *  vgeo,
				@restrict const  dfloat *  sgeo,
				@restrict const  dfloat *  ggeo,
				@restrict const  dfloat *  S,
				@restrict const  dfloat *  DT,
				@restrict const  dfloat *  LIFT,
				@restrict const  dfloat *  MM,
				@restrict const  dfloat *  sM,
				@restrict const  dlong  *  vmapM,
				@restrict const  int    *  EToB,
				@restrict const  int    *  mapB,
				const dfloat tau,
				const dfloat time,
				@restrict const  dfloat *  x,
				@restrict const  dfloat *  y,
				@restrict const  dfloat *  z,
				const dfloat lambda,
				const dfloat nu,
				@restrict const dfloat *  U,
				@restrict const dfloat *  RHS,
				@restrict       dfloat *  UH,
				@restrict       dfloat *  rhsU){
			       
  for(dlong e=0;e<Nelements;e++;@outer(0)){
    @shared dfloat s_u[p_Nq][p_Nq];
    @shared dfloat s_v[p_Nq][p_Nq];
    @shared dfloat s_ndu[p_Nq][p_Nq];
    @shared dfloat s_ndv[p_Nq][p_Nq];
    @shared dfloat s_DT[p_Nq][p_Nq];

    @exclusive dfloat r_ur[p_Nq], r_us[p_Nq], r_Au[p_Nq];
    @exclusive dfloat r_vr[p_Nq], r_vs[p_Nq], r_Av[p_Nq];
    @exclusive dfloat r_G00[p_Nq], r_G01[p_Nq], r_G11[p_Nq], r_GwJ[p_Nq];

    // loop over slabs
    for(int i=0;i<p_Nq;++i;@inner(0)){
      for(int j=0;j<p_Nq;++j){
        s_u[j][i] = 0.;
        s_v[j][i] = 0.;
        s_ndu[j][i] = 0.;
        s_ndv[j][i] = 0.;

        s_DT[j][i] = DT[j*p_Nq+i];
      }
    }


    // face 0 & 2
    for(int i=0;i<p_Nq;++i;@inner(0)){
      const dlong sk0 = e*p_Nfp*p_Nfaces + 0*p_Nfp + i;
      const dlong sk2 = e*p_Nfp*p_Nfaces + 2*p_Nfp + i;

      surfaceTerms(sk0,0,i,0     );
      surfaceTerms(sk2,2,i,p_Nq-1);
    }


    // face 1 & 3
    for(int j=0;j<p_Nq;++j;@inner(0)){
      const dlong sk1 = e*p_Nfp*p_Nfaces + 1*p_Nfp + j;
      const dlong sk3 = e*p_Nfp*p_Nfaces + 3*p_Nfp + j;

      surfaceTerms(sk1,1,p_Nq-1,j);
      surfaceTerms(sk3,3,0     ,j);
    }


    // loop over slabs
    for(int i=0;i<p_Nq;++i;@inner(0)){
      for(int j=0;j<p_Nq;++j){
        const dlong base = e*p_Nggeo*p_Np + j*p_Nq + i;

        r_G00[j] = ggeo[base+p_G00ID*p_Np];
        r_G01[j] = ggeo[base+p_G01ID*p_Np];
        r_G11[j] = ggeo[base+p_G11ID*p_Np];
        r_GwJ[j] = wJ[e*p_Np + j*p_Nq + i];

        dfloat ur = 0.f, us = 0.f;
        dfloat vr = 0.f, vs = 0.f;
#pragma unroll p_Nq
	for(int n=0; n<p_Nq; ++n){
	  ur += s_DT[i][n]*s_u[j][n];
	  vr += s_DT[i][n]*s_v[j][n];
	  us += s_DT[j][n]*s_u[n][i];
	  vs += s_DT[j][n]*s_v[n][i];
	}

        r_ur[j] = ur; r_us[j] = us;
        r_vr[j] = vr; r_vs[j] = vs;

        r_Au[j] = r_GwJ[j]*lambda*s_u[j][i];
        r_Av[j] = r_GwJ[j]*lambda*s_v[j][i];
      }
    }

    // r term ----->

    for(int i=0;i<p_Nq;++i;@inner(0)){
      for(int j=0;j<p_Nq;++j){
        s_u[j][i] = r_G00[j]*r_ur[j] + r_G01[j]*r_us[j];
        s_v[j][i] = r_G00[j]*r_vr[j] + r_G01[j]*r_vs[j];
      }
    }


    for(int i=0;i<p_Nq;++i;@inner(0)){
      for(int j=0;j<p_Nq;++j){
        dfloat tmpu = 0.f;
        dfloat tmpv = 0.f;
#pragma unroll p_Nq
	for(int n=0;n<p_Nq;++n) {
	  tmpu += s_DT[n][i]*s_u[j][n];
	  tmpv += s_DT[n][i]*s_v[j][n];
	}

        r_Au[j] += tmpu;
        r_Av[j] += tmpv;
      }
    }

    // s term ---->

    for(int i=0;i<p_Nq;++i;@inner(0)){
      for(int j=0;j<p_Nq;++j){
        s_u[j][i] = r_G01[j]*r_ur[j] + r_G11[j]*r_us[j];
        s_v[j][i] = r_G01[j]*r_vr[j] + r_G11[j]*r_vs[j];
      }
    }


    for(int i=0;i<p_Nq;++i;@inner(0)){
      for(int j=0;j<p_Nq;++j){
        const dfloat JW = wJ[i + j*p_Nq + e*p_Np];

        dfloat tmpu = 0.f;
        dfloat tmpv = 0.f;

#pragma unroll p_Nq
	for(int n=0;n<p_Nq;++n) {
	  tmpu += s_DT[n][j]*s_u[n][i];
	  tmpv += s_DT[n][j]*s_v[n][i];
	}

        r_Au[j] += tmpu;
        r_Av[j] += tmpv;

        const dlong id = e*p_Np + j*p_Nq + i;
        const dlong iid = p_NVfields*e*p_Np + j*p_Nq + i;
        rhsU[p_NVfields*id+0] = JW*RHS[iid+0*p_Np]/nu - (r_Au[j] + s_ndu[j][i]);
        rhsU[p_NVfields*id+1] = JW*RHS[iid+1*p_Np]/nu - (r_Av[j] + s_ndv[j][i]);

      }
    }
  }
}
#undef surfaceTerms

#define surfaceTerms(sk)                                                \
  {									\
    const dlong idM = vmapM[sk];					\
    const int bc = mapB[idM];						\
    if(bc>0) {								\
      const dfloat nx = sgeo[sk*p_Nsgeo+p_NXID];			\
      const dfloat ny = sgeo[sk*p_Nsgeo+p_NYID];			\
                                                                        \
      const dfloat uM = UH[p_NVfields*idM+0];					\
      const dfloat vM = UH[p_NVfields*idM+1];					\
                                                                        \
      dfloat uP=0;							\
      dfloat vP=0;							\
      dfloat ndotU = 1;							\
      insVelocityDirichletConditions2D(bc, ndotU, nu, time, x[idM], y[idM], nx, ny, uM, vM, &uP, &vP); \
      UH[p_NVfields*idM+0] = uP;							\
      UH[p_NVfields*idM+1] = vP;							\
    }									\
  }

// merge arrays back, and enter BCs if C0
@kernel void insStressBCQuad2D(const dlong Nelements,
				 @restrict const  dfloat *  sgeo,
				 @restrict const  dlong  *  vmapM,
				 @restrict const  int    *  mapB,
				 const dfloat time,
				 @restrict const  dfloat *  x,
				 @restrict const  dfloat *  y,
				 @restrict const  dfloat *  z,
				 const dfloat nu,
				 const int vDisc_c0,
				 @restrict        dfloat *  UH,
				 @restrict        dfloat *  U){

  if (vDisc_c0) {//fill masked boundary points if C0
    for(dlong e=0;e<Nelements;e++;@outer(0)){
      // face 0 & 2
      for(int i=0;i<p_Nq;++i;@inner(0)){
        const dlong sk0 = e*p_Nfp*p_Nfaces + 0*p_Nfp + i;
        const dlong sk2 = e*p_Nfp*p_Nfaces + 2*p_Nfp + i;

        surfaceTerms(sk0);
        surfaceTerms(sk2);
      }

      // face 1 & 3
      for(int j=0;j<p_Nq;++j;@inner(0)){
        const dlong sk1 = e*p_Nfp*p_Nfaces + 1*p_Nfp + j;
        const dlong sk3 = e*p_Nfp*p_Nfaces + 3*p_Nfp + j;

        surfaceTerms(sk1);
        surfaceTerms(sk3);
      }
    }
  }

  // Second outer loop to ensure UH is written before reading again
  for(dlong e=0;e<Nelements;e++;@outer(0)){
    for(int j=0;j<p_Nq;++j;@inner(1)){
      for(int i=0;i<p_Nq;++i;@inner(0)){
        const dlong id = e*p_Np+j*p_Nq+i;
        const dlong iid = e*p_Np*p_NVfields+j*p_Nq+i;
        U[iid+0*p_Np] = UH[p_NVfields*id+0];
        U[iid+1*p_Np] = UH[p_NVfields*id+1];
      }
    }
  }
}
