#define p_one ((dfloat)1.)
#define p_two ((dfloat)2.)

#define surfaceTerms1(sk,face,i, j)					\
  {									\
    const dlong idM = vmapM[sk];					\
    const dfloat nx = sgeo[sk*p_Nsgeo+p_NXID];				\
    const dfloat ny = sgeo[sk*p_Nsgeo+p_NYID];				\
    const dfloat WsJ = sgeo[sk*p_Nsgeo+p_WSJID];			\
    const dfloat nuMod = nut[idM];			\
    dfloat UM[p_NVfields] = {0.};					\
    dfloat UP[p_NVfields] = {0.};					\
    dfloat dudxP=0.f, dudyP=0.f, uP=0.f;				\
    dfloat dvdxP=0.f, dvdyP=0.f, vP=0.f;				\
    const int bc = mapB[idM];						\
    if(bc>0) {								\
      dfloat ndotU = 1;							\
      insVelocityDirichletConditions2D(bc, ndotU, nu, time, x[idM], y[idM], nx, ny, UM, UP); \
      insVelocityNeumannConditions2D(bc, nu, time, x[idM], y[idM], nx, ny, 0.f, 0.f, 0.f, 0.f, &dudxP, &dudyP, &dvdxP, &dvdyP);	\
    }									\
                                                                        \
    s_u  [j][i]  = UP[0];						\
    s_v  [j][i]  = UP[1];						\
    s_ndu[j][i] -= WsJ*nuMod*(p_two*nx*dudxP + ny*(dudyP+dvdxP));	\
    s_ndv[j][i] -= WsJ*nuMod*(p_two*ny*dvdyP + nx*(dudyP+dvdxP));	\
  }


// compute RHS = MM*RHS/nu + BCdata
// and split fields to separate arrays
@kernel void insStressRhsQuad2D(const dlong Nelements,
				@restrict const  dfloat *  wJ,
				@restrict const  dfloat *  vgeo,
				@restrict const  dfloat *  sgeo,
				@restrict const  dfloat *  ggeo,
				@restrict const  dfloat *  S,
				@restrict const  dfloat *  DT,
				@restrict const  dfloat *  LIFT,
				@restrict const  dfloat *  MM,
				@restrict const  dfloat *  sM,
				@restrict const  dlong  *  vmapM,
				@restrict const  int    *  EToB,
				@restrict const  int    *  mapB,
				const dfloat tau,
				const dfloat time,
				@restrict const  dfloat *  x,
				@restrict const  dfloat *  y,
				@restrict const  dfloat *  z,
				const dfloat lambda,
				const dfloat nuInv,
				@restrict const dfloat *  nut,
				@restrict const dfloat *  U,
				@restrict const dfloat *  RHS,
				@restrict       dfloat *  UH,
				@restrict       dfloat *  rhsU){
			       
  for(dlong e=0;e<Nelements;e++;@outer(0)){
    @shared dfloat s_u[p_Nq][p_Nq];
    @shared dfloat s_v[p_Nq][p_Nq];
    @shared dfloat s_tmpur[p_Nq][p_Nq];
    @shared dfloat s_tmpus[p_Nq][p_Nq];
    @shared dfloat s_tmpvr[p_Nq][p_Nq];
    @shared dfloat s_tmpvs[p_Nq][p_Nq];
    @shared dfloat s_ndu[p_Nq][p_Nq];
    @shared dfloat s_ndv[p_Nq][p_Nq];
    @shared dfloat s_DT[p_Nq][p_Nq];

    @exclusive dfloat r_Au[p_Nq];
    @exclusive dfloat r_Av[p_Nq];

    // loop over slabs
    for(int i=0;i<p_Nq;++i;@inner(0)){
      for(int j=0;j<p_Nq;++j){
        s_u[j][i] = 0.;
        s_v[j][i] = 0.;
        s_ndu[j][i] = 0.;
        s_ndv[j][i] = 0.;

        s_DT[j][i] = DT[j*p_Nq+i];
      }
    }


    // face 0 & 2
    for(int i=0;i<p_Nq;++i;@inner(0)){
      const dlong sk0 = e*p_Nfp*p_Nfaces + 0*p_Nfp + i;
      const dlong sk2 = e*p_Nfp*p_Nfaces + 2*p_Nfp + i;

      surfaceTerms1(sk0,0,i,0     );
      surfaceTerms1(sk2,2,i,p_Nq-1);
    }


    // face 1 & 3
    for(int j=0;j<p_Nq;++j;@inner(0)){
      const dlong sk1 = e*p_Nfp*p_Nfaces + 1*p_Nfp + j;
      const dlong sk3 = e*p_Nfp*p_Nfaces + 3*p_Nfp + j;

      surfaceTerms1(sk1,1,p_Nq-1,j);
      surfaceTerms1(sk3,3,0     ,j);
    }


    // loop over slabs
    for(int i=0;i<p_Nq;++i;@inner(0)){
      for(int j=0;j<p_Nq;++j){
        dfloat r_GwJ = wJ[e*p_Np + j*p_Nq + i];

        dfloat ur = 0.f, us = 0.f;
        dfloat vr = 0.f, vs = 0.f;

#pragma unroll p_Nq
	for(int n=0; n<p_Nq; ++n){
	  dfloat Din = s_DT[i][n];
	  dfloat Djn = s_DT[j][n];
	  ur += Din*s_u[j][n];
	  vr += Din*s_v[j][n];
	  us += Djn*s_u[n][i];
	  vs += Djn*s_v[n][i];
	}

        r_Au[j] = r_GwJ*lambda*s_u[j][i];
        r_Av[j] = r_GwJ*lambda*s_v[j][i];

        const dlong base = e*p_Nvgeo*p_Np + j*p_Nq + i;

	const dfloat rx = vgeo[base + p_RXID*p_Np];
	const dfloat ry = vgeo[base + p_RYID*p_Np];
	const dfloat sx = vgeo[base + p_SXID*p_Np];
	const dfloat sy = vgeo[base + p_SYID*p_Np];
	
	const dfloat nuMod = nut[e*p_Np+j*p_Nq+i];
	
	dfloat ux = rx*ur + sx*us;
	dfloat uy = ry*ur + sy*us;
	dfloat vx = rx*vr + sx*vs;
	dfloat vy = ry*vr + sy*vs;
	
	s_tmpur[j][i] = r_GwJ*nuMod*(rx*p_two*ux + ry*(uy+vx));
	s_tmpus[j][i] = r_GwJ*nuMod*(sx*p_two*ux + sy*(uy+vx));
	
	s_tmpvr[j][i] = r_GwJ*nuMod*(rx*(uy+vx) + ry*p_two*vy);
	s_tmpvs[j][i] = r_GwJ*nuMod*(sx*(uy+vx) + sy*p_two*vy);
      }
    }


    for(int i=0;i<p_Nq;++i;@inner(0)){
      for(int j=0;j<p_Nq;++j){
        dfloat tmpu = 0.f;
        dfloat tmpv = 0.f;
#pragma unroll p_Nq
	for(int n=0;n<p_Nq;++n) {
	  dfloat Dni = s_DT[n][i];
	  dfloat Dnj = s_DT[n][j];
	  tmpu += Dni*s_tmpur[j][n];
	  tmpv += Dni*s_tmpvr[j][n];
	  tmpu += Dnj*s_tmpus[n][i];
	  tmpv += Dnj*s_tmpvs[n][i];
	}
	
	r_Au[j] += tmpu;
        r_Av[j] += tmpv;
      }
      
      for(int j=0;j<p_Nq;++j){
        const dfloat JW = wJ[i + j*p_Nq + e*p_Np];
        const dlong id = e*p_Np + j*p_Nq + i;
        const dlong iid = p_dim*e*p_Np + j*p_Nq + i;
        rhsU[p_dim*id+0] = nuInv*JW*RHS[iid+0*p_Np] - (r_Au[j] + s_ndu[j][i]); // need to fix lambda
	rhsU[p_dim*id+1] = nuInv*JW*RHS[iid+1*p_Np] - (r_Av[j] + s_ndv[j][i]);
      }
    }
  }
}
#undef surfaceTerms

#define surfaceTerms2(sk)						\
  {									\
    const dlong idM = vmapM[sk];					\
    const int bc = mapB[idM];						\
    if(bc>0) {								\
      const dfloat nx = sgeo[sk*p_Nsgeo+p_NXID];			\
      const dfloat ny = sgeo[sk*p_Nsgeo+p_NYID];			\
      									\
      const dfloat uM = UH[p_dim*idM+0];				\
      const dfloat vM = UH[p_dim*idM+1];				\
                                                                        \
      dfloat UM[p_NVfields] = {0.};					\
      dfloat UP[p_NVfields] = {0.};					\
      UM[0] = uM;							\
      UM[1] = vM;							\
      dfloat ndotU = 1;							\
      insVelocityDirichletConditions2D(bc, ndotU, nu, time, x[idM], y[idM], nx, ny, UM, UP); \
      UH[p_dim*idM+0] = UP[0];						\
      UH[p_dim*idM+1] = UP[1];						\
    }									\
  }

// merge arrays back, and enter BCs if C0
@kernel void insStressBCQuad2D(const dlong Nelements,
			       @restrict const  dfloat *  sgeo,
			       @restrict const  dlong  *  vmapM,
			       @restrict const  int    *  mapB,
			       const dfloat time,
			       @restrict const  dfloat *  x,
			       @restrict const  dfloat *  y,
			       @restrict const  dfloat *  z,
			       const dfloat nu, // need to add nut
			       const int vDisc_c0,
			       @restrict        dfloat *  UH,
			       @restrict        dfloat *  U){
  
  if (vDisc_c0) {//fill masked boundary points if C0
    for(dlong e=0;e<Nelements;e++;@outer(0)){
      // face 0 & 2
      for(int i=0;i<p_Nq;++i;@inner(0)){
        const dlong sk0 = e*p_Nfp*p_Nfaces + 0*p_Nfp + i;
        const dlong sk2 = e*p_Nfp*p_Nfaces + 2*p_Nfp + i;

        surfaceTerms2(sk0);
        surfaceTerms2(sk2);
      }

      // face 1 & 3
      for(int j=0;j<p_Nq;++j;@inner(0)){
        const dlong sk1 = e*p_Nfp*p_Nfaces + 1*p_Nfp + j;
        const dlong sk3 = e*p_Nfp*p_Nfaces + 3*p_Nfp + j;

        surfaceTerms2(sk1);
        surfaceTerms2(sk3);
      }
    }
  }

  // Second outer loop to ensure UH is written before reading again
  for(dlong e=0;e<Nelements;e++;@outer(0)){
    for(int j=0;j<p_Nq;++j;@inner(1)){
      for(int i=0;i<p_Nq;++i;@inner(0)){
        const dlong id = e*p_Np+j*p_Nq+i;
        const dlong iid = e*p_Np*p_dim+j*p_Nq+i;
        U[iid+0*p_Np] = UH[p_dim*id+0];
        U[iid+1*p_Np] = UH[p_dim*id+1];
      }
    }
  }
}
