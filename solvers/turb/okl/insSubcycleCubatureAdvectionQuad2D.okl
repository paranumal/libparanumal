#define p_half ((dfloat)0.5)

// compute NU_x = (phi, u_e*du/dx + v_e*du/dy + 0.5*u*(du_e/dx + dv_e/dy) )
// compute NU_y = (phi, u_e*dv/dx + v_e*dv/dy + 0.5*v*(du_e/dx + dv_e/dy) )
@kernel void insSubcycleAdvectionCubatureVolumeQuad2D(const dlong Nelements,
						      @restrict const  dfloat *  vgeo,
						      @restrict const  dfloat *  cubvgeo,
						      @restrict const  dfloat *  cubDT,
						      @restrict const  dfloat *  cubPDT,
						      @restrict const  dfloat *  cubInterp,
						      @restrict const  dfloat *  cubProject,
						      @restrict const  dfloat *  Ue,
						      @restrict const  dfloat *  U,
						      @restrict  dfloat *  RHS){
  
  for(dlong eo=0;eo<Nelements;eo+=p_cubNblockV;@outer(0)){  // for all elements

    @shared dfloat    s_U[p_cubNblockV][p_NVfields][p_cubNq][p_cubNq];
    @shared dfloat s_rhsU[p_cubNblockV][p_NVfields][p_cubNq][p_cubNq];

    @shared dfloat s_Ue[p_cubNblockV][p_cubNq][p_cubNq];
    @shared dfloat s_Ve[p_cubNblockV][p_cubNq][p_cubNq];
    @shared dfloat s_rxdivU[p_cubNblockV][p_cubNq][p_cubNq];
    @shared dfloat s_rydivV[p_cubNblockV][p_cubNq][p_cubNq];
    @shared dfloat s_sxdivU[p_cubNblockV][p_cubNq][p_cubNq];
    @shared dfloat s_sydivV[p_cubNblockV][p_cubNq][p_cubNq];
    
    @shared dfloat s_cubInterp[p_Nq][p_cubNq];
    @shared dfloat s_cubProject[p_cubNq][p_Nq];
    @shared dfloat s_cubPDT[p_cubNq][p_Nq];
    @shared dfloat s_cubD[p_cubNq][p_cubNq];
    
    @exclusive dfloat r_Un[p_NVfields], r_Uen, r_Ven;
    @exclusive dfloat r_divUr, r_divUs, r_divVr, r_divVs;
    
    //fetch the Ue and V values and store in flux arrays in @shared
    for(int es=0;es<p_cubNblockV;++es;@inner(2)){
      for(int j=0;j<p_cubNq;++j;@inner(1)){
        for(int i=0;i<p_cubNq;++i;@inner(0)){
          const dlong e = eo+es; // element in block
          if(e<Nelements && i<p_Nq && j<p_Nq){
            const dlong id = e*p_Np*p_NVfields + j*p_Nq+i;

#pragma unroll p_NVfields
	    for(int fld=0;fld<p_NVfields;++fld)
	      s_U[es][fld][j][i]  = U[id+fld*p_Np];
	    
	    const dlong eid = e*p_Np*p_NVfields + j*p_Nq+i;
            s_Ue[es][j][i] = Ue[eid+0*p_Np];
            s_Ve[es][j][i] = Ue[eid+1*p_Np];
          }

	  s_cubD[j][i] = cubDT[j*p_cubNq+i];
	  
          if ((es==0) && j<p_Nq) {
            s_cubInterp[j][i] = cubInterp[i+j*p_cubNq];
          }
          if ((es==0) && i<p_Nq) {
            s_cubProject[j][i] = cubProject[i+j*p_Nq];
	    s_cubPDT[j][i] = cubPDT[i+j*p_Nq];
          }
        }
      }
    }

    //interpolate in i, store in register
    for(int es=0;es<p_cubNblockV;++es;@inner(2)){
      for(int j=0;j<p_cubNq;++j;@inner(1)){
        for(int i=0;i<p_cubNq;++i;@inner(0)){
          if (j<p_Nq) {
            r_Uen  = 0.; r_Ven  = 0.;

	    for(int fld=0;fld<p_NVfields;++fld)
	      r_Un[fld] = 0.; 

#pragma unroll p_Nq
            for (int n=0;n<p_Nq;n++) {
              const dfloat Ini = s_cubInterp[n][i];

#pragma unroll p_NVfields	      
	      for(int fld=0;fld<p_NVfields;++fld)
		r_Un[fld]  += Ini*s_U[es][fld][j][n];
	      
              r_Uen += Ini*s_Ue[es][j][n];
              r_Ven += Ini*s_Ve[es][j][n];
            }
	  }
        }
      }
    }
    
    //write register back to @shared
    for(int es=0;es<p_cubNblockV;++es;@inner(2)){
      for(int j=0;j<p_cubNq;++j;@inner(1)){
        for(int i=0;i<p_cubNq;++i;@inner(0)){
          if (j<p_Nq) {

#pragma unroll p_NVfields
	    for(int fld=0;fld<p_NVfields;++fld)
	      s_U[es][fld][j][i] = r_Un[fld];

            s_Ue[es][j][i] = r_Uen;
            s_Ve[es][j][i] = r_Ven;
          }
        }
      }
    }
  
    //interpolate in j and store flux in register
    for(int es=0;es<p_cubNblockV;++es;@inner(2)){
      for(int j=0;j<p_cubNq;++j;@inner(1)){
        for(int i=0;i<p_cubNq;++i;@inner(0)){

	  for(int fld=0;fld<p_NVfields;++fld)
	    r_Un[fld] = 0;

          r_Uen = 0.; r_Ven = 0.;

#pragma unroll p_Nq
          for (int n=0;n<p_Nq;n++) {
            const dfloat Inj = s_cubInterp[n][j];

#pragma unroll p_NVfields	    
	    for(int fld=0;fld<p_NVfields;++fld)
	      r_Un[fld]  += Inj*s_U[es][fld][n][i];

            r_Uen += Inj*s_Ue[es][n][i];
            r_Ven += Inj*s_Ve[es][n][i];
          }
        }
      }
    }
  
    //write register back to @shared
    for(int es=0;es<p_cubNblockV;++es;@inner(2)){
      for(int j=0;j<p_cubNq;++j;@inner(1)){
        for(int i=0;i<p_cubNq;++i;@inner(0)){

#pragma unroll p_NVfields
	  for(int fld=0;fld<p_NVfields;++fld)
	    s_U[es][fld][j][i] = r_Un[fld];

	  s_Ue[es][j][i] = r_Uen;
	  s_Ve[es][j][i] = r_Ven;
        }
      }
    }

    for(int es=0;es<p_cubNblockV;++es;@inner(2)){
      for(int j=0;j<p_cubNq;++j;@inner(1)){
        for(int i=0;i<p_cubNq;++i;@inner(0)){
          const dlong e = eo+es; // element in block
          if(e<Nelements){
            const dlong gid = e*p_cubNp*p_Nvgeo+ j*p_cubNq +i;
            const dfloat drdx = cubvgeo[gid + p_RXID*p_cubNp];
            const dfloat drdy = cubvgeo[gid + p_RYID*p_cubNp];
            const dfloat dsdx = cubvgeo[gid + p_SXID*p_cubNp];
            const dfloat dsdy = cubvgeo[gid + p_SYID*p_cubNp];
            const dfloat JW   = cubvgeo[gid + p_JWID*p_cubNp];

	    dfloat cUr[p_NVfields] = {0.};
	    dfloat cUs[p_NVfields] = {0.};
	    dfloat cUer = 0, cUes = 0, cVer = 0, cVes = 0;

#pragma unroll p_cubNq
	    for(int n=0;n<p_cubNq;++n){
	      dfloat Din = s_cubD[i][n];

#pragma unroll p_NVfields	      
	      for(int fld=0;fld<p_NVfields;++fld)
		cUr[fld] += Din*s_U[es][fld][j][n];

	      cUer += Din*s_Ue[es][j][n];
	      cVer += Din*s_Ve[es][j][n];
	    }

#pragma unroll p_cubNq
	    for(int n=0;n<p_cubNq;++n){
	      dfloat Djn = s_cubD[j][n];

#pragma unroll p_NVfields	      
	      for(int fld=0;fld<p_NVfields;++fld)
		cUs[fld] += Djn*s_U[es][fld][n][i];

	      cUes += Djn*s_Ue[es][n][i];
	      cVes += Djn*s_Ve[es][n][i];
	    }

	    dfloat cUex = drdx*cUer + dsdx*cUes;
	    dfloat cVey = drdy*cVer + dsdy*cVes;
	    dfloat cdivUe = cUex + cVey;

	    dfloat cdivU = 0;

#pragma unroll p_NVfields	    
	    for(int fld=0;fld<p_NVfields;++fld){
	      dfloat cUx = drdx*cUr[fld] + dsdx*cUs[fld];
	      dfloat cUy = drdy*cUr[fld] + dsdy*cUs[fld];
	      if(fld==0) cdivU += cUx;
	      if(fld==1) cdivU += cUy;

	      s_rhsU[es][fld][j][i] = JW*(r_Uen*cUx + r_Ven*cUy + p_half*r_Un[fld]*cdivUe);
	    }

	    s_rxdivU[es][j][i] = drdx*JW*cdivU; // sign
	    s_rydivV[es][j][i] = drdy*JW*cdivU; // sign
	    s_sxdivU[es][j][i] = dsdx*JW*cdivU; // sign
	    s_sydivV[es][j][i] = dsdy*JW*cdivU; // sign
	  }
	}
      }
    }
      

    //project/differentiate in j
    for(int es=0;es<p_cubNblockV;++es;@inner(2)){
      for(int j=0;j<p_cubNq;++j;@inner(1)){
        for(int i=0;i<p_cubNq;++i;@inner(0)){

#pragma unroll p_NVfields	  
	  for(int fld=0;fld<p_NVfields;++fld)
	    r_Un[fld] = 0;

	  r_divUr = 0; r_divUs = 0; r_divVr = 0; r_divVs = 0;
          if (j<p_Nq) {
#pragma unroll p_cubNq
            for (int n=0;n<p_cubNq;n++) {
              const dfloat Pnj = s_cubProject[n][j];
	      const dfloat Dnj = s_cubPDT[n][j];

#pragma unroll p_NVfields	      
	      for(int fld=0;fld<p_NVfields;++fld)
		r_Un[fld]  += Pnj*s_rhsU[es][fld][n][i];
	      
	      r_divUr += Pnj*s_rxdivU[es][n][i];
	      r_divVr += Pnj*s_rydivV[es][n][i];
	      r_divUs += Dnj*s_sxdivU[es][n][i];
	      r_divVs += Dnj*s_sydivV[es][n][i];
            }
          }
        }
      }
    }


    //write register back to @shared
    for(int es=0;es<p_cubNblockV;++es;@inner(2)){
      for(int j=0;j<p_cubNq;++j;@inner(1)){
        for(int i=0;i<p_cubNq;++i;@inner(0)){
          if (j<p_Nq) {

#pragma unroll p_NVfields	    
	    for(int fld=0;fld<p_NVfields;++fld)
	      s_rhsU[es][fld][j][i] = r_Un[fld];

	    s_rxdivU[es][j][i] = r_divUr;
	    s_rydivV[es][j][i] = r_divVr;
	    s_sxdivU[es][j][i] = r_divUs;
	    s_sydivV[es][j][i] = r_divVs;
          }
        }
      }
    }


    //project/differentiate in i and write back
    for(int es=0;es<p_cubNblockV;++es;@inner(2)){
      for(int j=0;j<p_cubNq;++j;@inner(1)){
        for(int i=0;i<p_cubNq;++i;@inner(0)){
          const dlong e = eo+es; // element in block
          if(e<Nelements && i<p_Nq && j<p_Nq){
            const dlong gid = e*p_Np*p_Nvgeo+ j*p_Nq +i;
            const dfloat invJW = vgeo[gid + p_IJWID*p_Np];
            const dfloat volh   = vgeo[gid + p_VOLHID*p_Np];
            dfloat nu[p_NVfields] = {0.f}, divUx = 0, divVy = 0;

#pragma unroll p_cubNq
	    for(int n=0;n<p_cubNq;++n){
	      const dfloat Pni = s_cubProject[n][i];
	      const dfloat Dni = s_cubPDT[n][i];

#pragma unroll p_NVfields	      
	      for(int fld=0;fld<p_NVfields;++fld)
		nu[fld]  += Pni*s_rhsU[es][fld][j][n];

	      divUx += Dni*s_rxdivU[es][j][n];
	      divVy += Dni*s_rydivV[es][j][n];
	      divUx += Pni*s_sxdivU[es][j][n];
	      divVy += Pni*s_sydivV[es][j][n];
	    }
//	    dfloat tauVol = 2.5e-3; // fix later  -2.e-3; // fix later
	    dfloat tauVol = 0.25*volh;  // 0.25
            const dlong id = e*p_Np*p_NVfields + j*p_Nq + i;

#pragma unroll p_NVfields	    
	    for(int fld=0;fld<p_NVfields;++fld){
	      dfloat tmp = nu[fld];
	      if(fld==0) tmp += tauVol*divUx;
	      if(fld==1) tmp += tauVol*divVy;
	      RHS[id+fld*p_Np] = -invJW*tmp;
	    }
          }
        }
      }
    }
  }
}



#define quadSurfaceTerms(face,m, i, j)                                  \
{                                                                       \
  dfloat nu[p_NVfields] = {0.f};					\
									\
  for(int n=0;n<p_cubNq;++n){                                           \
    const dfloat Pni = s_cubProject[n][m];				\
    for(int fld=0;fld<p_NVfields;++fld){				\
      nu[fld] += Pni*s_fluxNU[es][fld][face][n];			\
    }									\
  }                                                                     \
  for(int fld=0;fld<p_NVfields;++fld){					\
      s_NU[es][fld][j][i] += nu[fld];					\
  }									\
}


// strong form

@kernel void insSubcycleAdvectionCubatureSurfaceQuad2D(const dlong Nelements,
							@restrict const  dfloat *  vgeo,
							@restrict const  dfloat *  cubsgeo,
							@restrict const  dfloat *  cubInterp,
							@restrict const  dfloat *  cubProject,
							@restrict const  dlong  *  vmapM,
							@restrict const  dlong  *  vmapP,
							@restrict const  int    *  EToB,
							const dfloat time,
							@restrict const  dfloat *  intx,
							@restrict const  dfloat *  inty,
							@restrict const  dfloat *  intz,
							const dfloat nu,
							@restrict const  dfloat *  Ue,
							@restrict const  dfloat *  U,
							@restrict  dfloat *  RHS){
  

  // Need to fix this for NVfields
  
  // for all elements
  for(dlong eo=0;eo<Nelements;eo+=p_cubNblockS;@outer(0)){

    // @shared storage for flux terms
    @shared dfloat s_NU[p_cubNblockS][p_NVfields][p_Nq][p_Nq];

    @shared dfloat s_UeM[p_cubNblockS][p_Nfaces][p_cubNq];
    @shared dfloat s_VeM[p_cubNblockS][p_Nfaces][p_cubNq];

    @shared dfloat s_UdM[p_cubNblockS][p_NVfields][p_Nfaces][p_cubNq];
    @shared dfloat s_UdP[p_cubNblockS][p_NVfields][p_Nfaces][p_cubNq];

    //reuse @shared memory buffers
    #define s_fluxNU s_UdM
    #define s_fluxNV s_VdM

    @exclusive dfloat r_UeMn[p_Nfaces], r_VeMn[p_Nfaces];
    @exclusive dfloat r_UdMn[p_Nfaces][p_NVfields];
    @exclusive dfloat r_UdPn[p_Nfaces][p_NVfields];

    @shared dfloat s_cubInterp[p_Nq][p_cubNq];
    @shared dfloat s_cubProject[p_cubNq][p_Nq];

    // for all face nodes of all elements
    for(int es=0;es<p_cubNblockS;++es;@inner(1)){
      for(int i=0;i<p_cubNq;++i;@inner(0)){
        const dlong e = eo + es;
        if(e<Nelements && i<p_Nq){
          #pragma unroll p_Nfaces
          for (int face=0;face<p_Nfaces;face++) {
            const dlong id  = e*p_Nfp*p_Nfaces + face*p_Nq + i;
            const dlong idM = vmapM[id];
            const dlong idP = vmapP[id];

            // load traces
            const dlong eM = e;
            const dlong eP = idP/p_Np;
            const int vidM = idM%p_Np;
            const int vidP = idP%p_Np;

            const dlong qebaseM = eM*p_Np*p_NVfields + vidM;

            // load negative and positive trace node values of velocity
            s_UeM[es][face][i] = Ue[qebaseM+0*p_Np];
            s_VeM[es][face][i] = Ue[qebaseM+1*p_Np];

            const dlong qbaseM = eM*p_Np*p_NVfields + vidM;
            const dlong qbaseP = eP*p_Np*p_NVfields + vidP;

	    for(int fld=0;fld<p_NVfields;++fld){
	      s_UdM[es][fld][face][i] = U[qbaseM+fld*p_Np];
	    }
	    for(int fld=0;fld<p_NVfields;++fld){
	      s_UdP[es][fld][face][i] = U[qbaseP+fld*p_Np];
	    }
          }
        }

        //zero out resulting surface contributions
        if (i<p_Nq) {
#pragma unroll p_Nq
          for(int j=0;j<p_Nq;++j){
	    for(int fld=0;fld<p_NVfields;++fld){	    
	      s_NU[es][fld][j][i] = 0.;
	    }
          }
        }

        //fetch reference operators
        if (es==0) {
          #pragma unroll p_Nq
          for(int j=0;j<p_Nq;++j){
            s_cubInterp[j][i] = cubInterp[i+j*p_cubNq];
          }

          if (i<p_Nq) {
            #pragma unroll p_cubNq
            for(int j=0;j<p_cubNq;++j){
              s_cubProject[j][i] = cubProject[i+j*p_Nq];
            }
          }
        }
      }
    }


    //interpolate traces, store flux in register
    for(int es=0;es<p_cubNblockS;++es;@inner(1)){
      for(int i=0;i<p_cubNq;++i;@inner(0)){

#pragma unroll p_Nfaces
        for (int face=0;face<p_Nfaces;face++) {
          r_UeMn[face] = 0., r_VeMn[face] = 0.;

	  for(int fld=0;fld<p_NVfields;++fld){	    
	    r_UdMn[face][fld] = 0.;
	    r_UdPn[face][fld] = 0.;
	  }
	}

        #pragma unroll p_Nq
        for (int n=0;n<p_Nq;n++) {
          const dfloat Ini = s_cubInterp[n][i];

          #pragma unroll p_Nfaces
          for (int face=0;face<p_Nfaces;face++) {
            r_UeMn[face]  += Ini*s_UeM[es][face][n];
            r_VeMn[face]  += Ini*s_VeM[es][face][n];
	    for(int fld=0;fld<p_NVfields;++fld){
	      r_UdMn[face][fld]  += Ini*s_UdM[es][fld][face][n];
	      r_UdPn[face][fld]  += Ini*s_UdP[es][fld][face][n];
	    }
          }
        }
      }
    }


    //write fluxes to @shared
    for(int es=0;es<p_cubNblockS;++es;@inner(1)){
      for(int i=0;i<p_cubNq;++i;@inner(0)){
        const dlong e = eo + es;
        if(e<Nelements){
#pragma unroll p_Nfaces
          for (int face=0;face<p_Nfaces;face++) {
            const dlong sk = e*p_cubNq*p_Nfaces + face*p_cubNq + i;
            const dfloat nx = cubsgeo[sk*p_Nsgeo+p_NXID];
            const dfloat ny = cubsgeo[sk*p_Nsgeo+p_NYID];
            const dfloat WsJ = cubsgeo[sk*p_Nsgeo+p_WSJID];
	    const dfloat surfH = cubsgeo[sk*p_Nsgeo+p_MAXHID];
	    
            const dfloat ueM = r_UeMn[face], veM = r_VeMn[face];
	    dfloat ndotUe = nx*ueM + ny*veM;
            dfloat uenM   = fabs(ndotUe);
	    
            int bc = EToB[face+p_Nfaces*e];
            if(bc>0) {
              const dlong idm = e*p_Nfaces*p_cubNq + face*p_cubNq + i;
	      dfloat ix = intx[idm];
	      dfloat iy = inty[idm];
              insVelocityDirichletConditions2D(bc, ndotUe, nu, time, ix, iy, nx, ny, r_UdMn[face], r_UdPn[face]);
            }

	    dfloat tauSur = surfH; // fix this later ?
	    dfloat ndotdUd = nx*(r_UdMn[face][0]-r_UdPn[face][0]) + ny*(r_UdMn[face][1]-r_UdPn[face][1]);

	    dfloat fac = (nx*ueM+ny*veM-uenM);
	    for(int fld=0;fld<p_NVfields;++fld){
	      dfloat tmp = fac*(r_UdPn[face][fld] - r_UdMn[face][fld]);
	      if(fld==0) tmp += tauSur*nx*ndotdUd;
	      if(fld==1) tmp += tauSur*ny*ndotdUd;
	      s_fluxNU[es][fld][face][i] = WsJ*(p_half*tmp);
	    }
          }
        }
      }
    }


    // for all face nodes of all elements
    // face 0 & 2
    for(int es=0;es<p_cubNblockS;++es;@inner(1)){
      for(int i=0;i<p_cubNq;++i;@inner(0)){
        if(i<p_Nq){
          quadSurfaceTerms(0,i,i,0     );
          quadSurfaceTerms(2,i,i,p_Nq-1);
        }
      }
    }


    // face 1 & 3
    for(int es=0;es<p_cubNblockS;++es;@inner(1)){
      for(int j=0;j<p_cubNq;++j;@inner(0)){
        if(j<p_Nq){
          quadSurfaceTerms(1,j,p_Nq-1,j);
          quadSurfaceTerms(3,j,0     ,j);
        }
      }
    }


    // for each node in the element
    for(int es=0;es<p_cubNblockS;++es;@inner(1)){
      for(int i=0;i<p_cubNq;++i;@inner(0)){
        const dlong e = eo + es;
        if(e<Nelements && i<p_Nq){
#pragma unroll p_Nq
          for(int j=0;j<p_Nq;++j){
            const dlong gid = e*p_Np*p_Nvgeo+ j*p_Nq +i;
            const dfloat invJW = vgeo[gid + p_IJWID*p_Np];

            const dlong id = e*p_Np*p_NVfields + j*p_Nq + i;

	    for(int fld=0;fld<p_NVfields;++fld){
	      RHS[id+fld*p_Np] -= invJW*s_NU[es][fld][j][i];
	    }

          }
        }
      }
    }
  }
}




#undef quadSurfaceTerms

