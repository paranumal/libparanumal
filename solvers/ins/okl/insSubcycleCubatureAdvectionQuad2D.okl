#define p_half ((dfloat)0.5)

// compute NU = -div(uxu) using quadrature (weak form)
@kernel void insSubcycleAdvectionCubatureVolumeQuad2D_orig(const dlong Nelements,
                                            @restrict const  dfloat *  vgeo,
                                            @restrict const  dfloat *  cubvgeo,
                                            @restrict const  dfloat *  cubDT,
                                            @restrict const  dfloat *  cubPDT,
                                            @restrict const  dfloat *  cubInterp,
                                            @restrict const  dfloat *  cubProject,
                                            @restrict const  dfloat *  Ue,
                                            @restrict const  dfloat *  U,
                                                  @restrict  dfloat *  RHS){

  for(dlong eo=0;eo<Nelements;eo+=p_cubNblockV;@outer(0)){  // for all elements

    @shared dfloat s_F11[p_cubNblockV][p_cubNq][p_cubNq];
    @shared dfloat s_F12[p_cubNblockV][p_cubNq][p_cubNq];
    @shared dfloat s_F21[p_cubNblockV][p_cubNq][p_cubNq];
    @shared dfloat s_F22[p_cubNblockV][p_cubNq][p_cubNq];

    @shared dfloat s_U[p_cubNblockV][p_cubNq][p_cubNq];
    @shared dfloat s_V[p_cubNblockV][p_cubNq][p_cubNq];

    @shared dfloat s_cubInterp[p_Nq][p_cubNq];
    @shared dfloat s_cubProject[p_cubNq][p_Nq];
    @shared dfloat s_cubPDT[p_cubNq][p_Nq];

    @exclusive dfloat r_Un, r_Vn;
    @exclusive dfloat r_Udn, r_Vdn;
    @exclusive dfloat r_F11, r_F12, r_F21, r_F22;

    //fetch the Ue and V values and store in flux arrays in @shared
    for(int es=0;es<p_cubNblockV;++es;@inner(2)){
      for(int j=0;j<p_cubNq;++j;@inner(1)){
        for(int i=0;i<p_cubNq;++i;@inner(0)){
          const dlong e = eo+es; // element in block
          if(e<Nelements && i<p_Nq && j<p_Nq){
            const dlong id = e*p_Np*p_NVfields + j*p_Nq+i;

            const dfloat Uen = Ue[id+0*p_Np];
            const dfloat Ven = Ue[id+1*p_Np];
            const dfloat Udn = U[id+0*p_Np];
            const dfloat Vdn = U[id+1*p_Np];

            s_F11[es][j][i] = Uen;
            s_F12[es][j][i] = Ven;
            s_F21[es][j][i] = Udn;
            s_F22[es][j][i] = Vdn;
          }

          if ((es==0) && j<p_Nq) {
            s_cubInterp[j][i] = cubInterp[i+j*p_cubNq];
          }
          if ((es==0) && i<p_Nq) {
            s_cubProject[j][i] = cubProject[i+j*p_Nq];
            s_cubPDT[j][i] = cubPDT[i+j*p_Nq];
          }
        }
      }
    }


    //interpolate in i, store in register
    for(int es=0;es<p_cubNblockV;++es;@inner(2)){
      for(int j=0;j<p_cubNq;++j;@inner(1)){
        for(int i=0;i<p_cubNq;++i;@inner(0)){
          if (j<p_Nq) {
            r_Uen  = 0.; r_Ven  = 0.;
            r_Udn = 0.; r_Vdn = 0.;

            #pragma unroll p_Nq
            for (int n=0;n<p_Nq;n++) {
              const dfloat Ini = s_cubInterp[n][i];
              r_Uen += Ini*s_F11[es][j][n];
              r_Ven += Ini*s_F12[es][j][n];
              r_Udn += Ini*s_F21[es][j][n];
              r_Vdn += Ini*s_F22[es][j][n];
            }
          }
        }
      }
    }


    //write register back to @shared
    for(int es=0;es<p_cubNblockV;++es;@inner(2)){
      for(int j=0;j<p_cubNq;++j;@inner(1)){
        for(int i=0;i<p_cubNq;++i;@inner(0)){
          if (j<p_Nq) {
            s_F11[es][j][i] = r_Uen;
            s_F12[es][j][i] = r_Ven;
            s_F21[es][j][i] = r_Udn;
            s_F22[es][j][i] = r_Vdn;
          }
        }
      }
    }


    //interpolate in j and store flux in register
    for(int es=0;es<p_cubNblockV;++es;@inner(2)){
      for(int j=0;j<p_cubNq;++j;@inner(1)){
        for(int i=0;i<p_cubNq;++i;@inner(0)){
          r_Uen = 0.; r_Ven  = 0.;
          r_Udn = 0.; r_Vdn = 0.;

          #pragma unroll p_Nq
          for (int n=0;n<p_Nq;n++) {
            const dfloat Inj = s_cubInterp[n][j];
	    r_Uen += Inj*s_F11[es][n][i];
            r_Ven += Inj*s_F12[es][n][i];
            r_Udn += Inj*s_F21[es][n][i];
            r_Vdn += Inj*s_F22[es][n][i];
          }
	  s_U[es][j][i] = r_Udn;
	  s_V[es][j][i] = r_Vdn;
        }
      }
    }


    for(int es=0;es<p_cubNblockV;++es;@inner(2)){
      for(int j=0;j<p_cubNq;++j;@inner(1)){
        for(int i=0;i<p_cubNq;++i;@inner(0)){
          const dlong e = eo+es; // element in block
          if(e<Nelements){
            const dlong gid = e*p_cubNp*p_Nvgeo+ j*p_cubNq +i;
            const dfloat drdx = cubvgeo[gid + p_RXID*p_cubNp];
            const dfloat drdy = cubvgeo[gid + p_RYID*p_cubNp];
            const dfloat dsdx = cubvgeo[gid + p_SXID*p_cubNp];
            const dfloat dsdy = cubvgeo[gid + p_SYID*p_cubNp];
            const dfloat JW   = cubvgeo[gid + p_JWID*p_cubNp];

#if 0
	    const dfloat cUn = JW*(drdx*r_Un+drdy*r_Vn);
            const dfloat cVn = JW*(dsdx*r_Un+dsdy*r_Vn);

	    s_F11[es][j][i] = cUn*r_Udn;
            s_F12[es][j][i] = cVn*r_Udn;
            s_F21[es][j][i] = cUn*r_Vdn;
            s_F22[es][j][i] = cVn*r_Vdn;
#else
	    // compute divergence for penalization
	    dfloat cUr = 0, cUs = 0, cVr = 0, cVs = 0;
	    for(int n=0;n<p_cubNq;++n){
	      dfloat Din = cubDT[i*p_cubNq+n];
	      dfloat Djn = cubDT[j*p_cubNq+n];
	      cUr += Din*s_U[es][j][n];
	      cUs += Djn*s_U[es][n][i];
	      cVr += Din*s_V[es][j][n];
	      cVs += Djn*s_V[es][n][i];
	    }
	    dfloat WdivU =  JW*(drdx*cUr + dsdx*cUs + drdy*cVr + dsdy*cVs);
	    dfloat tauVol = -2.5e-3; // fix later  -2.e-3; // fix later
	    
	    const dfloat cUn = JW*(drdx*r_Un+drdy*r_Vn);
            const dfloat cVn = JW*(dsdx*r_Un+dsdy*r_Vn);

	    // Dr'*F11 + Ds'*F12
            s_F11[es][j][i] = cUn*r_Udn + tauVol*drdx*WdivU; 
            s_F12[es][j][i] = cVn*r_Udn + tauVol*dsdx*WdivU;
            s_F21[es][j][i] = cUn*r_Vdn + tauVol*drdy*WdivU;
            s_F22[es][j][i] = cVn*r_Vdn + tauVol*dsdy*WdivU;
#endif
          }
        }
      }
    }


    //project/differentiate in j
    for(int es=0;es<p_cubNblockV;++es;@inner(2)){
      for(int j=0;j<p_cubNq;++j;@inner(1)){
        for(int i=0;i<p_cubNq;++i;@inner(0)){
          r_F11  = 0.; r_F12  = 0.;
          r_F21  = 0.; r_F22  = 0.;

          if (j<p_Nq) {
            #pragma unroll p_cubNq
            for (int n=0;n<p_cubNq;n++) {
              const dfloat Pnj = s_cubProject[n][j];
              const dfloat Dnj = s_cubPDT[n][j];
              r_F11  += Pnj*s_F11[es][n][i];
              r_F21  += Pnj*s_F21[es][n][i];
              r_F12  += Dnj*s_F12[es][n][i];
              r_F22  += Dnj*s_F22[es][n][i];
            }
          }
        }
      }
    }


    //write register back to @shared
    for(int es=0;es<p_cubNblockV;++es;@inner(2)){
      for(int j=0;j<p_cubNq;++j;@inner(1)){
        for(int i=0;i<p_cubNq;++i;@inner(0)){
          if (j<p_Nq) {
            s_F11[es][j][i] = r_F11;
            s_F12[es][j][i] = r_F12;
            s_F21[es][j][i] = r_F21;
            s_F22[es][j][i] = r_F22;
          }
        }
      }
    }


    //project/differentiate in i and write back
    for(int es=0;es<p_cubNblockV;++es;@inner(2)){
      for(int j=0;j<p_cubNq;++j;@inner(1)){
        for(int i=0;i<p_cubNq;++i;@inner(0)){
          const dlong e = eo+es; // element in block
          if(e<Nelements && i<p_Nq && j<p_Nq){
            const dlong gid = e*p_Np*p_Nvgeo+ j*p_Nq +i;
            const dfloat invJW = vgeo[gid + p_IJWID*p_Np];

            dfloat nu = 0.f, nv = 0.f;

            #pragma unroll p_cubNq
              for(int n=0;n<p_cubNq;++n){
                const dfloat Pni = s_cubProject[n][i];
                const dfloat Dni = s_cubPDT[n][i];

                nu  += Dni*s_F11[es][j][n]
                      +Pni*s_F12[es][j][n];

                nv  += Dni*s_F21[es][j][n]
                      +Pni*s_F22[es][j][n];
              }

            const dlong id = e*p_Np*p_NVfields + j*p_Nq + i;
            RHS[id+0*p_Np] = invJW*nu;
            RHS[id+1*p_Np] = invJW*nv;
          }
        }
      }
    }
  }
}

// compute NU_x = (phi, u_e*du/dx + v_e*du/dy + 0.5*u*(du_e/dx + dv_e/dy) )
// compute NU_y = (phi, u_e*dv/dx + v_e*dv/dy + 0.5*v*(du_e/dx + dv_e/dy) )
@kernel void insSubcycleAdvectionCubatureVolumeQuad2D(const dlong Nelements,
						      @restrict const  dfloat *  vgeo,
						      @restrict const  dfloat *  cubvgeo,
						      @restrict const  dfloat *  cubDT,
						      @restrict const  dfloat *  cubPDT,
						      @restrict const  dfloat *  cubInterp,
						      @restrict const  dfloat *  cubProject,
						      @restrict const  dfloat *  Ue,
						      @restrict const  dfloat *  U,
						      @restrict  dfloat *  RHS){
  
  for(dlong eo=0;eo<Nelements;eo+=p_cubNblockV;@outer(0)){  // for all elements

    @shared dfloat s_U[p_cubNblockV][p_cubNq][p_cubNq];
    @shared dfloat s_V[p_cubNblockV][p_cubNq][p_cubNq];
    @shared dfloat s_Ue[p_cubNblockV][p_cubNq][p_cubNq];
    @shared dfloat s_Ve[p_cubNblockV][p_cubNq][p_cubNq];
    @shared dfloat s_rhsU[p_cubNblockV][p_cubNq][p_cubNq];
    @shared dfloat s_rhsV[p_cubNblockV][p_cubNq][p_cubNq];
    @shared dfloat s_rxdivU[p_cubNblockV][p_cubNq][p_cubNq];
    @shared dfloat s_rydivV[p_cubNblockV][p_cubNq][p_cubNq];
    @shared dfloat s_sxdivU[p_cubNblockV][p_cubNq][p_cubNq];
    @shared dfloat s_sydivV[p_cubNblockV][p_cubNq][p_cubNq];
    
    @shared dfloat s_cubInterp[p_Nq][p_cubNq];
    @shared dfloat s_cubProject[p_cubNq][p_Nq];
    @shared dfloat s_cubPDT[p_cubNq][p_Nq];
    @shared dfloat s_cubD[p_cubNq][p_cubNq];
    
    @exclusive dfloat r_Un, r_Vn, r_Uen, r_Ven;
    @exclusive dfloat r_divUr, r_divUs, r_divVr, r_divVs;
    
    //fetch the Ue and V values and store in flux arrays in @shared
    for(int es=0;es<p_cubNblockV;++es;@inner(2)){
      for(int j=0;j<p_cubNq;++j;@inner(1)){
        for(int i=0;i<p_cubNq;++i;@inner(0)){
          const dlong e = eo+es; // element in block
          if(e<Nelements && i<p_Nq && j<p_Nq){
            const dlong id = e*p_Np*p_NVfields + j*p_Nq+i;

            s_U[es][j][i]  = U[id+0*p_Np];
            s_V[es][j][i]  = U[id+1*p_Np];
            s_Ue[es][j][i] = Ue[id+0*p_Np];
            s_Ve[es][j][i] = Ue[id+1*p_Np];
          }

	  s_cubD[j][i] = cubDT[j*p_cubNq+i];
	  
          if ((es==0) && j<p_Nq) {
            s_cubInterp[j][i] = cubInterp[i+j*p_cubNq];
          }
          if ((es==0) && i<p_Nq) {
            s_cubProject[j][i] = cubProject[i+j*p_Nq];
	    s_cubPDT[j][i] = cubPDT[i+j*p_Nq];
          }
        }
      }
    }


    //interpolate in i, store in register
    for(int es=0;es<p_cubNblockV;++es;@inner(2)){
      for(int j=0;j<p_cubNq;++j;@inner(1)){
        for(int i=0;i<p_cubNq;++i;@inner(0)){
          if (j<p_Nq) {
            r_Uen  = 0.; r_Ven  = 0.;
            r_Un = 0.; r_Vn = 0.;

            #pragma unroll p_Nq
            for (int n=0;n<p_Nq;n++) {
              const dfloat Ini = s_cubInterp[n][i];
              r_Un  += Ini*s_U[es][j][n];
              r_Vn  += Ini*s_V[es][j][n];
              r_Uen += Ini*s_Ue[es][j][n];
              r_Ven += Ini*s_Ve[es][j][n];
            }
	  }
        }
      }
    }

    
    //write register back to @shared
    for(int es=0;es<p_cubNblockV;++es;@inner(2)){
      for(int j=0;j<p_cubNq;++j;@inner(1)){
        for(int i=0;i<p_cubNq;++i;@inner(0)){
          if (j<p_Nq) {
            s_U[es][j][i] = r_Un;
            s_V[es][j][i] = r_Vn;
            s_Ue[es][j][i] = r_Uen;
            s_Ve[es][j][i] = r_Ven;
          }
        }
      }
    }
  
    //interpolate in j and store flux in register
    for(int es=0;es<p_cubNblockV;++es;@inner(2)){
      for(int j=0;j<p_cubNq;++j;@inner(1)){
        for(int i=0;i<p_cubNq;++i;@inner(0)){
          r_Un  = 0.; r_Vn  = 0.;
          r_Uen = 0.; r_Ven = 0.;

          #pragma unroll p_Nq
          for (int n=0;n<p_Nq;n++) {
            const dfloat Inj = s_cubInterp[n][j];
            r_Un  += Inj*s_U[es][n][i];
            r_Vn  += Inj*s_V[es][n][i];
            r_Uen += Inj*s_Ue[es][n][i];
            r_Ven += Inj*s_Ve[es][n][i];
          }
        }
      }
    }
  
    //write register back to @shared
    for(int es=0;es<p_cubNblockV;++es;@inner(2)){
      for(int j=0;j<p_cubNq;++j;@inner(1)){
        for(int i=0;i<p_cubNq;++i;@inner(0)){
	  s_U[es][j][i] = r_Un;
	  s_V[es][j][i] = r_Vn;
	  s_Ue[es][j][i] = r_Uen;
	  s_Ve[es][j][i] = r_Ven;
        }
      }
    }

    for(int es=0;es<p_cubNblockV;++es;@inner(2)){
      for(int j=0;j<p_cubNq;++j;@inner(1)){
        for(int i=0;i<p_cubNq;++i;@inner(0)){
          const dlong e = eo+es; // element in block
          if(e<Nelements){
            const dlong gid = e*p_cubNp*p_Nvgeo+ j*p_cubNq +i;
            const dfloat drdx = cubvgeo[gid + p_RXID*p_cubNp];
            const dfloat drdy = cubvgeo[gid + p_RYID*p_cubNp];
            const dfloat dsdx = cubvgeo[gid + p_SXID*p_cubNp];
            const dfloat dsdy = cubvgeo[gid + p_SYID*p_cubNp];
            const dfloat JW   = cubvgeo[gid + p_JWID*p_cubNp];

	    dfloat cUr = 0, cUs = 0, cVr = 0, cVs = 0;
	    dfloat cUer = 0, cUes = 0, cVer = 0, cVes = 0;
	    
	    for(int n=0;n<p_cubNq;++n){
	      dfloat Din = s_cubD[i][n];

	      cUr += Din*s_U[es][j][n];
	      cVr += Din*s_V[es][j][n];
	      cUer += Din*s_Ue[es][j][n];
	      cVer += Din*s_Ve[es][j][n];
	    }

	    for(int n=0;n<p_cubNq;++n){
	      dfloat Djn = s_cubD[j][n];
	      
	      cUs += Djn*s_U[es][n][i];
	      cVs += Djn*s_V[es][n][i];
	      cUes += Djn*s_Ue[es][n][i];
	      cVes += Djn*s_Ve[es][n][i];
	    }

	    dfloat cUx = drdx*cUr + dsdx*cUs;
	    dfloat cUy = drdy*cUr + dsdy*cUs;
	    dfloat cVx = drdx*cVr + dsdx*cVs;
	    dfloat cVy = drdy*cVr + dsdy*cVs;
	    dfloat cUex = drdx*cUer + dsdx*cUes;
	    dfloat cVey = drdy*cVer + dsdy*cVes;
	    dfloat cdivU = cUx + cVy;
	    dfloat cdivUe = cUex + cVey;

	    s_rhsU[es][j][i] = JW*(r_Uen*cUx + r_Ven*cUy + p_half*r_Un*cdivUe);
	    s_rhsV[es][j][i] = JW*(r_Uen*cVx + r_Ven*cVy + p_half*r_Vn*cdivUe);

	    s_rxdivU[es][j][i] = drdx*JW*cdivU; // sign
	    s_rydivV[es][j][i] = drdy*JW*cdivU; // sign
	    s_sxdivU[es][j][i] = dsdx*JW*cdivU; // sign
	    s_sydivV[es][j][i] = dsdy*JW*cdivU; // sign
	  }
	}
      }
    }
      

    //project/differentiate in j
    for(int es=0;es<p_cubNblockV;++es;@inner(2)){
      for(int j=0;j<p_cubNq;++j;@inner(1)){
        for(int i=0;i<p_cubNq;++i;@inner(0)){
          r_Un = 0; r_Vn = 0; r_divUr = 0; r_divUs = 0; r_divVr = 0; r_divVs = 0;
          if (j<p_Nq) {
#pragma unroll p_cubNq
            for (int n=0;n<p_cubNq;n++) {
              const dfloat Pnj = s_cubProject[n][j];
	      const dfloat Dnj = s_cubPDT[n][j];
              r_Un  += Pnj*s_rhsU[es][n][i];
              r_Vn  += Pnj*s_rhsV[es][n][i];
	      r_divUr += Pnj*s_rxdivU[es][n][i];
	      r_divVr += Pnj*s_rydivV[es][n][i];
	      r_divUs += Dnj*s_sxdivU[es][n][i];
	      r_divVs += Dnj*s_sydivV[es][n][i];
            }
          }
        }
      }
    }


    //write register back to @shared
    for(int es=0;es<p_cubNblockV;++es;@inner(2)){
      for(int j=0;j<p_cubNq;++j;@inner(1)){
        for(int i=0;i<p_cubNq;++i;@inner(0)){
          if (j<p_Nq) {
            s_rhsU[es][j][i] = r_Un;
            s_rhsV[es][j][i] = r_Vn;
	    s_rxdivU[es][j][i] = r_divUr;
	    s_rydivV[es][j][i] = r_divVr;
	    s_sxdivU[es][j][i] = r_divUs;
	    s_sydivV[es][j][i] = r_divVs;
          }
        }
      }
    }


    //project/differentiate in i and write back
    for(int es=0;es<p_cubNblockV;++es;@inner(2)){
      for(int j=0;j<p_cubNq;++j;@inner(1)){
        for(int i=0;i<p_cubNq;++i;@inner(0)){
          const dlong e = eo+es; // element in block
          if(e<Nelements && i<p_Nq && j<p_Nq){
            const dlong gid = e*p_Np*p_Nvgeo+ j*p_Nq +i;
            const dfloat invJW = vgeo[gid + p_IJWID*p_Np];

            dfloat nu = 0.f, nv = 0.f, divUx = 0, divVy = 0;

#pragma unroll p_cubNq
	    for(int n=0;n<p_cubNq;++n){
	      const dfloat Pni = s_cubProject[n][i];
	      const dfloat Dni = s_cubPDT[n][i];
	      nu  += Pni*s_rhsU[es][j][n];
	      nv  += Pni*s_rhsV[es][j][n];
	      divUx += Dni*s_rxdivU[es][j][n];
	      divVy += Dni*s_rydivV[es][j][n];
	      divUx += Pni*s_sxdivU[es][j][n];
	      divVy += Pni*s_sydivV[es][j][n];
	    }
	    dfloat tauVol = 2.5e-3; // fix later  -2.e-3; // fix later	    
            const dlong id = e*p_Np*p_NVfields + j*p_Nq + i;
            RHS[id+0*p_Np] = -invJW*(nu+tauVol*divUx);// note sign change
            RHS[id+1*p_Np] = -invJW*(nv+tauVol*divVy);
          }
        }
      }
    }
  }
}




#define quadSurfaceTerms(face,m, i, j)                                  \
{                                                                       \
  dfloat nu = 0.f, nv = 0.f;                                            \
                                                                        \
  for(int n=0;n<p_cubNq;++n){                                           \
    const dfloat Pni = s_cubProject[n][m];                             \
    nu  += Pni*s_fluxNU[es][face][n];                                   \
    nv  += Pni*s_fluxNV[es][face][n];                                   \
  }                                                                     \
                                                                        \
  s_NU[es][j][i] += nu;                                                 \
  s_NV[es][j][i] += nv;                                                 \
}


@kernel void insSubcycleAdvectionCubatureSurfaceQuad2D_orig(const dlong Nelements,
                                            @restrict const  dfloat *  vgeo,
                                            @restrict const  dfloat *  cubsgeo,
                                            @restrict const  dfloat *  cubInterp,
                                            @restrict const  dfloat *  cubProject,
                                            @restrict const  dlong  *  vmapM,
                                            @restrict const  dlong  *  vmapP,
                                            @restrict const  int    *  EToB,
                                            const dfloat time,
                                            @restrict const  dfloat *  intx,
                                            @restrict const  dfloat *  inty,
                                            @restrict const  dfloat *  intz,
                                            const dfloat nu,
                                            @restrict const  dfloat *  Ue,
                                            @restrict const  dfloat *  U,
                                                  @restrict  dfloat *  RHS){

  // for all elements
  for(dlong eo=0;eo<Nelements;eo+=p_cubNblockS;@outer(0)){
    // @shared storage for flux terms
    @shared dfloat s_NU[p_cubNblockS][p_Nq][p_Nq];
    @shared dfloat s_NV[p_cubNblockS][p_Nq][p_Nq];

    @shared dfloat s_UM[p_cubNblockS][p_Nfaces][p_cubNq];
    @shared dfloat s_VM[p_cubNblockS][p_Nfaces][p_cubNq];
    @shared dfloat s_UP[p_cubNblockS][p_Nfaces][p_cubNq];
    @shared dfloat s_VP[p_cubNblockS][p_Nfaces][p_cubNq];

    @shared dfloat s_UdM[p_cubNblockS][p_Nfaces][p_cubNq];
    @shared dfloat s_VdM[p_cubNblockS][p_Nfaces][p_cubNq];
    @shared dfloat s_UdP[p_cubNblockS][p_Nfaces][p_cubNq];
    @shared dfloat s_VdP[p_cubNblockS][p_Nfaces][p_cubNq];

    //reuse @shared memory buffers
    #define s_fluxNU s_UM
    #define s_fluxNV s_VM

    @exclusive dfloat r_UMn[p_Nfaces], r_VMn[p_Nfaces];
    @exclusive dfloat r_UPn[p_Nfaces], r_VPn[p_Nfaces];
    @exclusive dfloat r_UdMn[p_Nfaces], r_VdMn[p_Nfaces];
    @exclusive dfloat r_UdPn[p_Nfaces], r_VdPn[p_Nfaces];

    @shared dfloat s_cubInterp[p_Nq][p_cubNq];
    @shared dfloat s_cubProject[p_cubNq][p_Nq];

    // for all face nodes of all elements
    for(int es=0;es<p_cubNblockS;++es;@inner(1)){
      for(int i=0;i<p_cubNq;++i;@inner(0)){
        const dlong e = eo + es;
        if(e<Nelements && i<p_Nq){
          #pragma unroll p_Nfaces
          for (int face=0;face<p_Nfaces;face++) {
            const dlong id  = e*p_Nfp*p_Nfaces + face*p_Nq + i;
            const dlong idM = vmapM[id];
            const dlong idP = vmapP[id];

            // load traces
            const dlong eM = e;
            const dlong eP = idP/p_Np;
            const int vidM = idM%p_Np;
            const int vidP = idP%p_Np;

            const dlong qbaseM = eM*p_Np*p_NVfields + vidM;
            const dlong qbaseP = eP*p_Np*p_NVfields + vidP;

            // load negative and positive trace node values of velocity
            s_UM[es][face][i] = Ue[qbaseM+0*p_Np];
            s_VM[es][face][i] = Ue[qbaseM+1*p_Np];
            s_UP[es][face][i] = Ue[qbaseP+0*p_Np];
            s_VP[es][face][i] = Ue[qbaseP+1*p_Np];

	    //	    if( fabs(s_UM[es][face][i]-s_UP[es][face][i] )>1e-10*fabs(s_UM[es][face][i]))
	    //	      printf("dUe=%e, dVe=%e\n", s_UM[es][face][i]-s_UP[es][face][i], s_VM[es][face][i]-s_VP[es][face][i]);
	    
            s_UdM[es][face][i] = U[qbaseM+0*p_Np];
            s_VdM[es][face][i] = U[qbaseM+1*p_Np];
            s_UdP[es][face][i] = U[qbaseP+0*p_Np];
            s_VdP[es][face][i] = U[qbaseP+1*p_Np];
          }
        }

        //zero out resulting surface contributions
        if (i<p_Nq) {
          #pragma unroll p_Nq
          for(int j=0;j<p_Nq;++j){
            s_NU[es][j][i] = 0.;
            s_NV[es][j][i] = 0.;
          }
        }

        //fetch reference operators
        if (es==0) {
          #pragma unroll p_Nq
          for(int j=0;j<p_Nq;++j){
            s_cubInterp[j][i] = cubInterp[i+j*p_cubNq];
          }

          if (i<p_Nq) {
            #pragma unroll p_cubNq
            for(int j=0;j<p_cubNq;++j){
              s_cubProject[j][i] = cubProject[i+j*p_Nq];
            }
          }
        }
      }
    }


    //interpolate traces, store flux in register
    for(int es=0;es<p_cubNblockS;++es;@inner(1)){
      for(int i=0;i<p_cubNq;++i;@inner(0)){
        #pragma unroll p_Nfaces
        for (int face=0;face<p_Nfaces;face++) {
          r_UMn[face] = 0., r_VMn[face] = 0.;
          r_UPn[face] = 0., r_VPn[face] = 0.;
          r_UdMn[face] = 0., r_VdMn[face] = 0.;
          r_UdPn[face] = 0., r_VdPn[face] = 0.;
        }

        #pragma unroll p_Nq
        for (int n=0;n<p_Nq;n++) {
          const dfloat Ini = s_cubInterp[n][i];

          #pragma unroll p_Nfaces
          for (int face=0;face<p_Nfaces;face++) {
            r_UMn[face]  += Ini*s_UM[es][face][n];
            r_VMn[face]  += Ini*s_VM[es][face][n];
            r_UPn[face]  += Ini*s_UP[es][face][n];
            r_VPn[face]  += Ini*s_VP[es][face][n];
            r_UdMn[face]  += Ini*s_UdM[es][face][n];
            r_VdMn[face]  += Ini*s_VdM[es][face][n];
            r_UdPn[face]  += Ini*s_UdP[es][face][n];
            r_VdPn[face]  += Ini*s_VdP[es][face][n];
          }
        }
      }
    }


    //write fluxes to @shared
    for(int es=0;es<p_cubNblockS;++es;@inner(1)){
      for(int i=0;i<p_cubNq;++i;@inner(0)){
        const dlong e = eo + es;
        if(e<Nelements){
          #pragma unroll p_Nfaces
          for (int face=0;face<p_Nfaces;face++) {
            const dlong sk = e*p_cubNq*p_Nfaces + face*p_cubNq + i;
            const dfloat nx = cubsgeo[sk*p_Nsgeo+p_NXID];
            const dfloat ny = cubsgeo[sk*p_Nsgeo+p_NYID];
            const dfloat WsJ = cubsgeo[sk*p_Nsgeo+p_WSJID];

            const dfloat uM = r_UMn[face], vM = r_VMn[face];
            const dfloat uP = r_UPn[face], vP = r_VPn[face];
            const dfloat udM = r_UdMn[face], vdM = r_VdMn[face];
                  dfloat udP = r_UdPn[face], vdP = r_VdPn[face];
		  
            int bc = EToB[face+p_Nfaces*e];
            if(bc>0) {
	      dfloat ndotU = nx*uM + ny*vM;
              const dlong idm = e*p_Nfaces*p_cubNq + face*p_cubNq + i;
              insVelocityDirichletConditions2D(bc, ndotU, nu, time, intx[e*p_Nfaces*p_cubNq + face*p_cubNq + i], \
                                                         inty[e*p_Nfaces*p_cubNq + face*p_cubNq + i], \
                                                         nx, ny, udM, vdM, &udP, &vdP);
            }

            dfloat unM   = fabs(nx*uM + ny*vM);
            dfloat unP   = fabs(nx*uP + ny*vP);
	    dfloat unMax = (unM > unP) ? unM : unP;
	    //	    dfloat unMax = 0.5f*(unM+unP);

#if 0
	    unMax = (unMax<1) ? 1:unMax;

            s_fluxNU[es][face][i] = WsJ*(.5f*(nx*(uP*udP + uM*udM) + ny*(vP*udP + vM*udM)  + unMax*(udM-udP)));
            s_fluxNV[es][face][i] = WsJ*(.5f*(nx*(uP*vdP + uM*vdM) + ny*(vP*vdP + vM*vdM)  + unMax*(vdM-vdP)));

#else

	    dfloat tauSur = 0.5; // fix this later ?
	    dfloat ndotdUd = nx*(udM-udP) + ny*(vdM-vdP);

            s_fluxNU[es][face][i] = WsJ*(.5f*(nx*(uP*udP + uM*udM) + ny*(vP*udP + vM*udM)  + unMax*(udM-udP) + tauSur*nx*ndotdUd));
            s_fluxNV[es][face][i] = WsJ*(.5f*(nx*(uP*vdP + uM*vdM) + ny*(vP*vdP + vM*vdM)  + unMax*(vdM-vdP) + tauSur*ny*ndotdUd));
	    
	    
#endif

          }
        }
      }
    }


    // for all face nodes of all elements
    // face 0 & 2
    for(int es=0;es<p_cubNblockS;++es;@inner(1)){
      for(int i=0;i<p_cubNq;++i;@inner(0)){
        if(i<p_Nq){
          quadSurfaceTerms(0,i,i,0     );
          quadSurfaceTerms(2,i,i,p_Nq-1);
        }
      }
    }


    // face 1 & 3
    for(int es=0;es<p_cubNblockS;++es;@inner(1)){
      for(int j=0;j<p_cubNq;++j;@inner(0)){
        if(j<p_Nq){
          quadSurfaceTerms(1,j,p_Nq-1,j);
          quadSurfaceTerms(3,j,0     ,j);
        }
      }
    }


    // for each node in the element
    for(int es=0;es<p_cubNblockS;++es;@inner(1)){
      for(int i=0;i<p_cubNq;++i;@inner(0)){
        const dlong e = eo + es;
        if(e<Nelements && i<p_Nq){
          #pragma unroll p_Nq
          for(int j=0;j<p_Nq;++j){
            const dlong gid = e*p_Np*p_Nvgeo+ j*p_Nq +i;
            const dfloat invJW = vgeo[gid + p_IJWID*p_Np];

            const dlong id = e*p_Np*p_NVfields + j*p_Nq + i;

            RHS[id+0*p_Np] -= invJW*s_NU[es][j][i];
            RHS[id+1*p_Np] -= invJW*s_NV[es][j][i];
          }
        }
      }
    }
  }
}

@kernel void insSubcycleAdvectionCubatureSurfaceQuad2D_v1(const dlong Nelements,
                                            @restrict const  dfloat *  vgeo,
                                            @restrict const  dfloat *  cubsgeo,
                                            @restrict const  dfloat *  cubInterp,
                                            @restrict const  dfloat *  cubProject,
                                            @restrict const  dlong  *  vmapM,
                                            @restrict const  dlong  *  vmapP,
                                            @restrict const  int    *  EToB,
                                            const dfloat time,
                                            @restrict const  dfloat *  intx,
                                            @restrict const  dfloat *  inty,
                                            @restrict const  dfloat *  intz,
                                            const dfloat nu,
                                            @restrict const  dfloat *  Ue,
                                            @restrict const  dfloat *  U,
                                                  @restrict  dfloat *  RHS){

  // for all elements
  for(dlong eo=0;eo<Nelements;eo+=p_cubNblockS;@outer(0)){
    // @shared storage for flux terms
    @shared dfloat s_NU[p_cubNblockS][p_Nq][p_Nq];
    @shared dfloat s_NV[p_cubNblockS][p_Nq][p_Nq];

    @shared dfloat s_UM[p_cubNblockS][p_Nfaces][p_cubNq];
    @shared dfloat s_VM[p_cubNblockS][p_Nfaces][p_cubNq];
    @shared dfloat s_UP[p_cubNblockS][p_Nfaces][p_cubNq];
    @shared dfloat s_VP[p_cubNblockS][p_Nfaces][p_cubNq];

    @shared dfloat s_UdM[p_cubNblockS][p_Nfaces][p_cubNq];
    @shared dfloat s_VdM[p_cubNblockS][p_Nfaces][p_cubNq];
    @shared dfloat s_UdP[p_cubNblockS][p_Nfaces][p_cubNq];
    @shared dfloat s_VdP[p_cubNblockS][p_Nfaces][p_cubNq];

    //reuse @shared memory buffers
    #define s_fluxNU s_UM
    #define s_fluxNV s_VM

    @exclusive dfloat r_UMn[p_Nfaces], r_VMn[p_Nfaces];
    @exclusive dfloat r_UPn[p_Nfaces], r_VPn[p_Nfaces];
    @exclusive dfloat r_UdMn[p_Nfaces], r_VdMn[p_Nfaces];
    @exclusive dfloat r_UdPn[p_Nfaces], r_VdPn[p_Nfaces];

    @shared dfloat s_cubInterp[p_Nq][p_cubNq];
    @shared dfloat s_cubProject[p_cubNq][p_Nq];

    // for all face nodes of all elements
    for(int es=0;es<p_cubNblockS;++es;@inner(1)){
      for(int i=0;i<p_cubNq;++i;@inner(0)){
        const dlong e = eo + es;
        if(e<Nelements && i<p_Nq){
          #pragma unroll p_Nfaces
          for (int face=0;face<p_Nfaces;face++) {
            const dlong id  = e*p_Nfp*p_Nfaces + face*p_Nq + i;
            const dlong idM = vmapM[id];
            const dlong idP = vmapP[id];

            // load traces
            const dlong eM = e;
            const dlong eP = idP/p_Np;
            const int vidM = idM%p_Np;
            const int vidP = idP%p_Np;

            const dlong qbaseM = eM*p_Np*p_NVfields + vidM;
            const dlong qbaseP = eP*p_Np*p_NVfields + vidP;

            // load negative and positive trace node values of velocity
            s_UM[es][face][i] = Ue[qbaseM+0*p_Np];
            s_VM[es][face][i] = Ue[qbaseM+1*p_Np];
            s_UP[es][face][i] = Ue[qbaseP+0*p_Np];
            s_VP[es][face][i] = Ue[qbaseP+1*p_Np];

            s_UdM[es][face][i] = U[qbaseM+0*p_Np];
            s_VdM[es][face][i] = U[qbaseM+1*p_Np];
            s_UdP[es][face][i] = U[qbaseP+0*p_Np];
            s_VdP[es][face][i] = U[qbaseP+1*p_Np];
          }
        }

        //zero out resulting surface contributions
        if (i<p_Nq) {
          #pragma unroll p_Nq
          for(int j=0;j<p_Nq;++j){
            s_NU[es][j][i] = 0.;
            s_NV[es][j][i] = 0.;
          }
        }

        //fetch reference operators
        if (es==0) {
          #pragma unroll p_Nq
          for(int j=0;j<p_Nq;++j){
            s_cubInterp[j][i] = cubInterp[i+j*p_cubNq];
          }

          if (i<p_Nq) {
            #pragma unroll p_cubNq
            for(int j=0;j<p_cubNq;++j){
              s_cubProject[j][i] = cubProject[i+j*p_Nq];
            }
          }
        }
      }
    }


    //interpolate traces, store flux in register
    for(int es=0;es<p_cubNblockS;++es;@inner(1)){
      for(int i=0;i<p_cubNq;++i;@inner(0)){
        #pragma unroll p_Nfaces
        for (int face=0;face<p_Nfaces;face++) {
          r_UMn[face] = 0., r_VMn[face] = 0.;
          r_UPn[face] = 0., r_VPn[face] = 0.;
          r_UdMn[face] = 0., r_VdMn[face] = 0.;
          r_UdPn[face] = 0., r_VdPn[face] = 0.;
        }

        #pragma unroll p_Nq
        for (int n=0;n<p_Nq;n++) {
          const dfloat Ini = s_cubInterp[n][i];

          #pragma unroll p_Nfaces
          for (int face=0;face<p_Nfaces;face++) {
            r_UMn[face]  += Ini*s_UM[es][face][n];
            r_VMn[face]  += Ini*s_VM[es][face][n];
            r_UPn[face]  += Ini*s_UP[es][face][n];
            r_VPn[face]  += Ini*s_VP[es][face][n];
            r_UdMn[face]  += Ini*s_UdM[es][face][n];
            r_VdMn[face]  += Ini*s_VdM[es][face][n];
            r_UdPn[face]  += Ini*s_UdP[es][face][n];
            r_VdPn[face]  += Ini*s_VdP[es][face][n];
          }
        }
      }
    }


    @shared dfloat s_maxLambda[p_cubNblockS][p_cubNq];
    @exclusive dfloat nx, ny, WsJ, unMax;
    @exclusive dfloat uM, uP, unM, udM, udP;
    @exclusive dfloat vM, vP, unP, vdM, vdP;
    //write fluxes to @shared

#pragma unroll p_Nfaces
    for (int face=0;face<p_Nfaces;face++) {

      @barrier();
      
      for(int es=0;es<p_cubNblockS;++es;@inner(1)){
	for(int i=0;i<p_cubNq;++i;@inner(0)){
	  const dlong e = eo + es;
	  if(e<Nelements){
            const dlong sk = e*p_cubNq*p_Nfaces + face*p_cubNq + i;
            nx = cubsgeo[sk*p_Nsgeo+p_NXID];
            ny = cubsgeo[sk*p_Nsgeo+p_NYID];
            WsJ = cubsgeo[sk*p_Nsgeo+p_WSJID];
	    
            uM = r_UMn[face];
	    vM = r_VMn[face];
            uP = r_UPn[face];
	    vP = r_VPn[face];
            udM = r_UdMn[face];
	    vdM = r_VdMn[face];
	    udP = r_UdPn[face];
	    vdP = r_VdPn[face];
	    
            int bc = EToB[face+p_Nfaces*e];
            if(bc>0) {
	      dfloat ndotU = nx*uM + ny*vM;
              const dlong idm = e*p_Nfaces*p_cubNq + face*p_cubNq + i;
              insVelocityDirichletConditions2D(bc, ndotU, nu, time, intx[e*p_Nfaces*p_cubNq + face*p_cubNq + i], inty[e*p_Nfaces*p_cubNq + face*p_cubNq + i],  nx, ny, udM, vdM, &udP, &vdP);
            }
	    
            unM   = fabs(nx*uM + ny*vM); // sqrt(uM*uM+vM*vM); 
            unP   = fabs(nx*uP + ny*vP); // sqrt(uP*uP+vP*vP);
            unMax = (unM > unP) ? unM : unP;
	  }
	  
	  s_fluxNU[es][face][i] = WsJ*(.5f*(nx*(uP*udP + uM*udM) + ny*(vP*udP + vM*udM)  + unMax*(udM-udP) ));
	  s_fluxNV[es][face][i] = WsJ*(.5f*(nx*(uP*vdP + uM*vdM) + ny*(vP*vdP + vM*vdM)  + unMax*(vdM-vdP) ));
        }
      }      
    }


    // for all face nodes of all elements
    // face 0 & 2
    for(int es=0;es<p_cubNblockS;++es;@inner(1)){
      for(int i=0;i<p_cubNq;++i;@inner(0)){
        if(i<p_Nq){
          quadSurfaceTerms(0,i,i,0     );
          quadSurfaceTerms(2,i,i,p_Nq-1);
        }
      }
    }


    // face 1 & 3
    for(int es=0;es<p_cubNblockS;++es;@inner(1)){
      for(int j=0;j<p_cubNq;++j;@inner(0)){
        if(j<p_Nq){
          quadSurfaceTerms(1,j,p_Nq-1,j);
          quadSurfaceTerms(3,j,0     ,j);
        }
      }
    }


    // for each node in the element
    for(int es=0;es<p_cubNblockS;++es;@inner(1)){
      for(int i=0;i<p_cubNq;++i;@inner(0)){
        const dlong e = eo + es;
        if(e<Nelements && i<p_Nq){
          #pragma unroll p_Nq
          for(int j=0;j<p_Nq;++j){
            const dlong gid = e*p_Np*p_Nvgeo+ j*p_Nq +i;
            const dfloat invJW = vgeo[gid + p_IJWID*p_Np];

            const dlong id = e*p_Np*p_NVfields + j*p_Nq + i;

            RHS[id+0*p_Np] -= invJW*s_NU[es][j][i];
            RHS[id+1*p_Np] -= invJW*s_NV[es][j][i];
          }
        }
      }
    }
  }
}


// strong form
@kernel void insSubcycleAdvectionCubatureSurfaceQuad2D(const dlong Nelements,
							@restrict const  dfloat *  vgeo,
							@restrict const  dfloat *  cubsgeo,
							@restrict const  dfloat *  cubInterp,
							@restrict const  dfloat *  cubProject,
							@restrict const  dlong  *  vmapM,
							@restrict const  dlong  *  vmapP,
							@restrict const  int    *  EToB,
							const dfloat time,
							@restrict const  dfloat *  intx,
							@restrict const  dfloat *  inty,
							@restrict const  dfloat *  intz,
							const dfloat nu,
							@restrict const  dfloat *  Ue,
							@restrict const  dfloat *  U,
							@restrict  dfloat *  RHS){
  
  // for all elements
  for(dlong eo=0;eo<Nelements;eo+=p_cubNblockS;@outer(0)){
    // @shared storage for flux terms
    @shared dfloat s_NU[p_cubNblockS][p_Nq][p_Nq];
    @shared dfloat s_NV[p_cubNblockS][p_Nq][p_Nq];

    @shared dfloat s_UM[p_cubNblockS][p_Nfaces][p_cubNq];
    @shared dfloat s_VM[p_cubNblockS][p_Nfaces][p_cubNq];
    @shared dfloat s_UP[p_cubNblockS][p_Nfaces][p_cubNq];
    @shared dfloat s_VP[p_cubNblockS][p_Nfaces][p_cubNq];

    @shared dfloat s_UdM[p_cubNblockS][p_Nfaces][p_cubNq];
    @shared dfloat s_VdM[p_cubNblockS][p_Nfaces][p_cubNq];
    @shared dfloat s_UdP[p_cubNblockS][p_Nfaces][p_cubNq];
    @shared dfloat s_VdP[p_cubNblockS][p_Nfaces][p_cubNq];

    //reuse @shared memory buffers
    #define s_fluxNU s_UM
    #define s_fluxNV s_VM

    @exclusive dfloat r_UMn[p_Nfaces], r_VMn[p_Nfaces];
    @exclusive dfloat r_UPn[p_Nfaces], r_VPn[p_Nfaces];
    @exclusive dfloat r_UdMn[p_Nfaces], r_VdMn[p_Nfaces];
    @exclusive dfloat r_UdPn[p_Nfaces], r_VdPn[p_Nfaces];

    @shared dfloat s_cubInterp[p_Nq][p_cubNq];
    @shared dfloat s_cubProject[p_cubNq][p_Nq];

    // for all face nodes of all elements
    for(int es=0;es<p_cubNblockS;++es;@inner(1)){
      for(int i=0;i<p_cubNq;++i;@inner(0)){
        const dlong e = eo + es;
        if(e<Nelements && i<p_Nq){
          #pragma unroll p_Nfaces
          for (int face=0;face<p_Nfaces;face++) {
            const dlong id  = e*p_Nfp*p_Nfaces + face*p_Nq + i;
            const dlong idM = vmapM[id];
            const dlong idP = vmapP[id];

            // load traces
            const dlong eM = e;
            const dlong eP = idP/p_Np;
            const int vidM = idM%p_Np;
            const int vidP = idP%p_Np;

            const dlong qbaseM = eM*p_Np*p_NVfields + vidM;
            const dlong qbaseP = eP*p_Np*p_NVfields + vidP;

            // load negative and positive trace node values of velocity
            s_UM[es][face][i] = Ue[qbaseM+0*p_Np];
            s_VM[es][face][i] = Ue[qbaseM+1*p_Np];
            s_UP[es][face][i] = Ue[qbaseP+0*p_Np];
            s_VP[es][face][i] = Ue[qbaseP+1*p_Np];

	    //	    if( fabs(s_UM[es][face][i]-s_UP[es][face][i] )>1e-10*fabs(s_UM[es][face][i]))
	    //	      printf("dUe=%e, dVe=%e\n", s_UM[es][face][i]-s_UP[es][face][i], s_VM[es][face][i]-s_VP[es][face][i]);
	    
            s_UdM[es][face][i] = U[qbaseM+0*p_Np];
            s_VdM[es][face][i] = U[qbaseM+1*p_Np];
            s_UdP[es][face][i] = U[qbaseP+0*p_Np];
            s_VdP[es][face][i] = U[qbaseP+1*p_Np];
          }
        }

        //zero out resulting surface contributions
        if (i<p_Nq) {
          #pragma unroll p_Nq
          for(int j=0;j<p_Nq;++j){
            s_NU[es][j][i] = 0.;
            s_NV[es][j][i] = 0.;
          }
        }

        //fetch reference operators
        if (es==0) {
          #pragma unroll p_Nq
          for(int j=0;j<p_Nq;++j){
            s_cubInterp[j][i] = cubInterp[i+j*p_cubNq];
          }

          if (i<p_Nq) {
            #pragma unroll p_cubNq
            for(int j=0;j<p_cubNq;++j){
              s_cubProject[j][i] = cubProject[i+j*p_Nq];
            }
          }
        }
      }
    }


    //interpolate traces, store flux in register
    for(int es=0;es<p_cubNblockS;++es;@inner(1)){
      for(int i=0;i<p_cubNq;++i;@inner(0)){
        #pragma unroll p_Nfaces
        for (int face=0;face<p_Nfaces;face++) {
          r_UMn[face] = 0., r_VMn[face] = 0.;
          r_UPn[face] = 0., r_VPn[face] = 0.;
          r_UdMn[face] = 0., r_VdMn[face] = 0.;
          r_UdPn[face] = 0., r_VdPn[face] = 0.;
        }

        #pragma unroll p_Nq
        for (int n=0;n<p_Nq;n++) {
          const dfloat Ini = s_cubInterp[n][i];

          #pragma unroll p_Nfaces
          for (int face=0;face<p_Nfaces;face++) {
            r_UMn[face]  += Ini*s_UM[es][face][n];
            r_VMn[face]  += Ini*s_VM[es][face][n];
            r_UPn[face]  += Ini*s_UP[es][face][n];
            r_VPn[face]  += Ini*s_VP[es][face][n];
            r_UdMn[face]  += Ini*s_UdM[es][face][n];
            r_VdMn[face]  += Ini*s_VdM[es][face][n];
            r_UdPn[face]  += Ini*s_UdP[es][face][n];
            r_VdPn[face]  += Ini*s_VdP[es][face][n];
          }
        }
      }
    }


    //write fluxes to @shared
    for(int es=0;es<p_cubNblockS;++es;@inner(1)){
      for(int i=0;i<p_cubNq;++i;@inner(0)){
        const dlong e = eo + es;
        if(e<Nelements){
          #pragma unroll p_Nfaces
          for (int face=0;face<p_Nfaces;face++) {
            const dlong sk = e*p_cubNq*p_Nfaces + face*p_cubNq + i;
            const dfloat nx = cubsgeo[sk*p_Nsgeo+p_NXID];
            const dfloat ny = cubsgeo[sk*p_Nsgeo+p_NYID];
            const dfloat WsJ = cubsgeo[sk*p_Nsgeo+p_WSJID];

            const dfloat uM = r_UMn[face], vM = r_VMn[face];
            const dfloat uP = r_UPn[face], vP = r_VPn[face];
            const dfloat udM = r_UdMn[face], vdM = r_VdMn[face];
                  dfloat udP = r_UdPn[face], vdP = r_VdPn[face];

            int bc = EToB[face+p_Nfaces*e];
            if(bc>0) {
	      dfloat ndotU = nx*uM + ny*vM;
              const dlong idm = e*p_Nfaces*p_cubNq + face*p_cubNq + i;
              insVelocityDirichletConditions2D(bc, ndotU, nu, time, intx[e*p_Nfaces*p_cubNq + face*p_cubNq + i], \
                                                         inty[e*p_Nfaces*p_cubNq + face*p_cubNq + i], \
                                                         nx, ny, udM, vdM, &udP, &vdP);
            }

            dfloat unM   = fabs(nx*uM + ny*vM);
            dfloat unP   = fabs(nx*uP + ny*vP);
	    dfloat unMax = (unM > unP) ? unM : unP;
	    //	    dfloat unMax = 0.5f*(unM+unP);

#if 0
	    unMax = (unMax<1) ? 1:unMax;

            s_fluxNU[es][face][i] = WsJ*(.5f*(nx*(uP*udP + uM*udM) + ny*(vP*udP + vM*udM)  + unMax*(udM-udP)));
            s_fluxNV[es][face][i] = WsJ*(.5f*(nx*(uP*vdP + uM*vdM) + ny*(vP*vdP + vM*vdM)  + unMax*(vdM-vdP)));

#else

	    dfloat tauSur = 0.5; // fix this later ?
	    dfloat ndotdUd = nx*(udM-udP) + ny*(vdM-vdP);

            s_fluxNU[es][face][i] = WsJ*(.5f*(nx*(uP*udP - uM*udM) + ny*(vP*udP - vM*udM)  + unMax*(udM-udP) + tauSur*nx*ndotdUd));
            s_fluxNV[es][face][i] = WsJ*(.5f*(nx*(uP*vdP - uM*vdM) + ny*(vP*vdP - vM*vdM)  + unMax*(vdM-vdP) + tauSur*ny*ndotdUd));
	    
	    
#endif

          }
        }
      }
    }


    // for all face nodes of all elements
    // face 0 & 2
    for(int es=0;es<p_cubNblockS;++es;@inner(1)){
      for(int i=0;i<p_cubNq;++i;@inner(0)){
        if(i<p_Nq){
          quadSurfaceTerms(0,i,i,0     );
          quadSurfaceTerms(2,i,i,p_Nq-1);
        }
      }
    }


    // face 1 & 3
    for(int es=0;es<p_cubNblockS;++es;@inner(1)){
      for(int j=0;j<p_cubNq;++j;@inner(0)){
        if(j<p_Nq){
          quadSurfaceTerms(1,j,p_Nq-1,j);
          quadSurfaceTerms(3,j,0     ,j);
        }
      }
    }


    // for each node in the element
    for(int es=0;es<p_cubNblockS;++es;@inner(1)){
      for(int i=0;i<p_cubNq;++i;@inner(0)){
        const dlong e = eo + es;
        if(e<Nelements && i<p_Nq){
          #pragma unroll p_Nq
          for(int j=0;j<p_Nq;++j){
            const dlong gid = e*p_Np*p_Nvgeo+ j*p_Nq +i;
            const dfloat invJW = vgeo[gid + p_IJWID*p_Np];

            const dlong id = e*p_Np*p_NVfields + j*p_Nq + i;

            RHS[id+0*p_Np] -= invJW*s_NU[es][j][i];
            RHS[id+1*p_Np] -= invJW*s_NV[es][j][i];
          }
        }
      }
    }
  }
}



#undef quadSurfaceTerms

