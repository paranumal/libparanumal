@kernel void insQfactorHex3D(const dlong Nelements,
			     @restrict const  dfloat *  vgeo,
			     @restrict const  dfloat *  DT,
			     @restrict const  dfloat *  U,
			     @restrict  dfloat *  QF){
  

  for(dlong e=0;e<Nelements;e++;@outer(0)){  // for all elements

    @shared dfloat s_U[p_Nq][p_Nq][p_Nq];
    @shared dfloat s_V[p_Nq][p_Nq][p_Nq];
    @shared dfloat s_W[p_Nq][p_Nq][p_Nq];

    @shared dfloat s_DT[p_Nq][p_Nq];

    for(int k=0;k<p_Nq;++k;@inner(2)){
      for(int j=0;j<p_Nq;++j;@inner(1)){
        for(int i=0;i<p_Nq;++i;@inner(0)){
          const dlong id = e*p_Np*p_NVfields + k*p_Nq*p_Nq + j*p_Nq+i;

          s_U[k][j][i]  = U[id + 0*p_Np];
          s_V[k][j][i]  = U[id + 1*p_Np];
          s_W[k][j][i]  = U[id + 2*p_Np];

          if (k==0)
            s_DT[j][i] = DT[j*p_Nq+i];
        }
      }
    }

    // Make sure all node data is loaded into @shared

    for(int k=0;k<p_Nq;++k;@inner(2)){
      for(int j=0;j<p_Nq;++j;@inner(1)){
        for(int i=0;i<p_Nq;++i;@inner(0)){
          const dlong gid = e*p_Np*p_Nvgeo +k*p_Nq*p_Nq +j*p_Nq +i;
          const dfloat rx = vgeo[gid + p_RXID*p_Np];
          const dfloat ry = vgeo[gid + p_RYID*p_Np];
          const dfloat rz = vgeo[gid + p_RZID*p_Np];
          const dfloat sx = vgeo[gid + p_SXID*p_Np];
          const dfloat sy = vgeo[gid + p_SYID*p_Np];
          const dfloat sz = vgeo[gid + p_SZID*p_Np];
          const dfloat tx = vgeo[gid + p_TXID*p_Np];
          const dfloat ty = vgeo[gid + p_TYID*p_Np];
          const dfloat tz = vgeo[gid + p_TZID*p_Np];

          // compute 'r' and 's' derivatives of (q_m) at node n
          dfloat ur  = 0.f, us  = 0.f, ut  = 0.f;
          dfloat vr  = 0.f, vs  = 0.f, vt  = 0.f;
          dfloat wr  = 0.f, ws  = 0.f, wt  = 0.f;

#pragma unroll p_Nq
	  for(int n=0;n<p_Nq;++n){
	    const dfloat Dr = s_DT[i][n];
	    const dfloat Ds = s_DT[j][n];
	    const dfloat Dt = s_DT[k][n];

	    ur += Dr*s_U[k][j][n];
	    us += Ds*s_U[k][n][i];
	    ut += Dt*s_U[n][j][i];

	    vr += Dr*s_V[k][j][n];
	    vs += Ds*s_V[k][n][i];
	    vt += Dt*s_V[n][j][i];

	    wr += Dr*s_W[k][j][n];
	    ws += Ds*s_W[k][n][i];
	    wt += Dt*s_W[n][j][i];

	  }

	  const dfloat ux = rx*ur + sx*us + tx*ut;
	  const dfloat uy = ry*ur + sy*us + ty*ut;
	  const dfloat uz = rz*ur + sz*us + tz*ut;
	    
	  const dfloat vx = rx*vr + sx*vs + tx*vt;
	  const dfloat vy = ry*vr + sy*vs + ty*vt;
	  const dfloat vz = rz*vr + sz*vs + tz*vt;
	    
	  const dfloat wx = rx*wr + sx*ws + tx*wt;
	  const dfloat wy = ry*wr + sy*ws + ty*wt;
	  const dfloat wz = rz*wr + sz*ws + tz*wt;
	           
	  dfloat QFn = 0;
	  QFn += ux*ux;
	  QFn += uy*vx;
	  QFn += uz*wx;
	  QFn += vx*uy;
	  QFn += vy*vy;
	  QFn += vz*wy;
	  QFn += wx*uz;
	  QFn += wy*vz;
	  QFn += wz*wz;

	  const dlong id = e*p_Np*p_NVfields+k*p_Nq*p_Nq + j*p_Nq + i;
	  QF[id] = -((dfloat)0.5)*QFn;
	  QF[id+1*p_Np] = 0;
	  QF[id+2*p_Np] = 0;
        }
      }
    }
  }
}

